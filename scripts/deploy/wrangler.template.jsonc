// Copiado pra uma pasta temporária por scripts/deploy/publicar.sh. Fica fora da raiz de propósito:
// na raiz, o wrangler tenta "converter" o projeto Astro e reescreve astro.config, package.json e tsconfig.
// ALIMENTA_API_ORIGIN: /api/alimenta/* do Worker vai pra esta API (VPS própria, api.pontape.org). keep_vars mantém as vars do painel que não estão aqui.
{
  "name": "pontape",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pontape", "database_id": "4a0e6b60-9273-4c40-a3f6-31a10f5f5da5", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "HIT_RATE_LIMITER", "namespace_id": "4301", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "ALIMENTA_API_ORIGIN": "https://api.pontape.org" },
  "keep_vars": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "pontape.org", "custom_domain": true },
    { "pattern": "www.pontape.org", "custom_domain": true },
    { "pattern": "alimenta.pontape.org", "custom_domain": true }
  ]
}
