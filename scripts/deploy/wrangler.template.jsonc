// Copiado pra uma pasta temporária por scripts/deploy/publicar.sh. Fica fora da raiz de propósito:
// na raiz, o wrangler tenta "converter" o projeto Astro e reescreve astro.config, package.json e tsconfig.
{
  "name": "pontape",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "pontape.org", "custom_domain": true },
    { "pattern": "www.pontape.org", "custom_domain": true }
  ]
}
