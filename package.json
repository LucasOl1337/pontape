{
  "name": "vidanova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pontape": "bin/pontape.mjs"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "cli": "node bin/pontape.mjs",
    "test:cli": "node scripts/generate-yumi-knowledge.mjs && vitest run scripts/cli",
    "test:python": "python3 -B -m unittest discover -s tools -p 'test_*.py'",
    "test:all": "npm test && npm run test:python",
    "dev": "astro dev",
    "build": "node scripts/generate-yumi-knowledge.mjs && astro build && node scripts/csp-headers.mjs generate && node scripts/csp-headers.mjs verify",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "node scripts/generate-yumi-knowledge.mjs",
    "typecheck": "astro check",
    "pretest": "node scripts/generate-yumi-knowledge.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run ledger:verify && npm run build && npm run budget",
    "ledger:append": "node scripts/ledger/append.ts",
    "ledger:verify": "node scripts/ledger/verify.ts",
    "ledger:sign": "node scripts/ledger/sign.ts",
    "ledger:drain": "node scripts/ledger/drain.ts",
    "ledger:stamp": "node scripts/ledger/stamp-head.ts",
    "ledger:reconcile": "node scripts/ledger/reconcile.ts",
    "budget": "node scripts/check-budget.mjs",
    "ledger:sync-project": "node scripts/ledger/sync-project.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@noble/curves": "2.4.0",
    "astro": "7.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
