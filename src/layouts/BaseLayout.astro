---
import '../styles/global.css';
import IconSprite from '../components/site/IconSprite.astro';
import StatusStrip from '../components/site/StatusStrip.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import PaletteSwitcher from '../components/site/PaletteSwitcher.astro';
import { SHARE } from '../data/site/share';
import { PROJECT_NAME } from '../data/site/project';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'transparencia' | 'construir' | 'not-found';
  share?: keyof typeof SHARE;
  noindex?: boolean;
  /** The "em construção" strip. The home says it in its own first screen (F29). */
  strip?: boolean;
}

const { title, description, current, share = 'home', noindex = false, strip = true } = Astro.props;
const card = SHARE[share];
// Share previews need absolute URLs. `site` comes from SITE_URL at build (astro.config.mjs);
// until the domain exists the paths stay relative.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3EEE4" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={PROJECT_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute(card.image)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(card.image)} />
    <meta name="twitter:image:alt" content={card.alt} />
    <link rel="preload" href="/fonts/newsreader-display-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-text-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <slot name="head" />
    <!-- A paleta entra antes da primeira pintura. O build inclui o hash na CSP. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.replace('no-js', 'js');
        const valid = /^(jornal|anil|pauta|envelope|pessego|carvao)$/;
        let palette = null;
        let fromUrl = false;
        try {
          const value = new URL(location.href).searchParams.get('cor');
          if (value && valid.test(value)) { palette = value; fromUrl = true; }
        } catch { /* URL indisponível */ }
        if (!palette) {
          try {
            const value = localStorage.getItem('pontape-paleta');
            if (value && valid.test(value)) palette = value;
          } catch { /* armazenamento indisponível */ }
        }
        if (palette) {
          document.documentElement.dataset.palette = palette;
          if (fromUrl) try { localStorage.setItem('pontape-paleta', palette); } catch { /* só nesta página */ }
        }
        document.addEventListener('DOMContentLoaded', () => {
          const paper = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim();
          if (paper) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', paper);
        });
      })();
    </script>
  </head>
  <body data-strip={strip ? undefined : 'off'}>
    <IconSprite />
    <a class="skip-link" href="#conteudo">Pular pro conteúdo</a>
    {strip && <StatusStrip />}
    <SiteHeader current={current} />
    <main id="conteudo" tabindex="-1"><slot /></main>
    <SiteFooter />
    <PaletteSwitcher />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
