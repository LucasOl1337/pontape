---
import '../styles/global.css';
import IconSprite from '../components/site/IconSprite.astro';
import StatusStrip from '../components/site/StatusStrip.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { SHARE } from '../data/site/share';
import { PROJECT_NAME } from '../data/site/project';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'transparencia';
  share?: keyof typeof SHARE;
  noindex?: boolean;
}

const { title, description, current, share = 'home', noindex = false } = Astro.props;
const card = SHARE[share];
// Share previews need absolute URLs. `site` comes from SITE_URL at build (astro.config.mjs);
// until the domain exists the paths stay relative.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4F1EA" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={PROJECT_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute(card.image)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(card.image)} />
    <meta name="twitter:image:alt" content={card.alt} />
    <link rel="preload" href="/fonts/atkinson-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <IconSprite />
    <a class="skip-link" href="#conteudo">Pular pro conteúdo</a>
    <StatusStrip />
    <SiteHeader current={current} />
    <main id="conteudo" tabindex="-1"><slot /></main>
    <SiteFooter />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
