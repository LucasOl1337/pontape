---
import Icon from './Icon.astro';
import { PROJECT_NAME } from '../../data/site/project';
interface Props { current?: 'home' | 'transparencia' }
const { current = 'home' } = Astro.props;
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="logo" href="/" aria-label={`${PROJECT_NAME}, início`}><span class="logo-symbol" aria-hidden="true">{PROJECT_NAME.charAt(0).toLowerCase()}.</span><span>{PROJECT_NAME}</span></a>
    <nav class="site-nav" aria-label="Principal">
      <a href={current === 'home' ? '#como-funciona' : '/#como-funciona'}>Como funciona</a>
      <a href={current === 'home' ? '#modulos' : '/#modulos'}>As partes</a>
      <a href="/transparencia" aria-current={current === 'transparencia' ? 'page' : undefined}>Livro público <Icon name="arrow-right" /></a>
    </nav>
  </div>
</header>
