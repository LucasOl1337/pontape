---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { PROJECT_NAME } from '../../data/site/project';
import { CONSTRUIR } from '../../data/site/cadernos';
import { LIVRO } from '../../data/site/livro';
import { PERGUNTAS } from '../../data/site/perguntas';

interface Props { current?: 'home' | 'transparencia' | 'construir' | 'perguntas' | 'not-found' }
const { current = 'home' } = Astro.props;
const onHome = current === 'home';
// Inside a section the door stays marked: the page itself at its address, the section below it
// (the cadernos under /construir, the technical page under /transparencia).
const path = Astro.url.pathname.replace(/\/$/, '');
const marked = (section: typeof current, href: string) => (current === section ? (path === href ? 'page' as const : 'true' as const) : undefined);
// Four doors in plain words (F29). The builder words sit behind "Construir junto".
const links = [
  { href: onHome ? '#como-funciona' : '/#como-funciona', label: 'Como funciona' },
  { href: LIVRO.href, label: 'Transparência', current: marked('transparencia', LIVRO.href) },
  { href: onHome ? '#ajudar' : '/#ajudar', label: 'Como ajudar' },
  { href: CONSTRUIR.href, label: CONSTRUIR.name, current: marked('construir', CONSTRUIR.href) },
  { href: PERGUNTAS.href, label: PERGUNTAS.name, current: marked('perguntas', PERGUNTAS.href) },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="logo" href="/" aria-label={`${PROJECT_NAME}, início`}><LogoMark /><span>{PROJECT_NAME}</span></a>
    <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><Icon name="menu" /><span>Menu</span></button>
    <nav class="site-nav" id="site-nav" aria-label="Principal">
      <ul>
        {links.map(l => <li><a href={l.href} aria-current={l.current}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="icon-btn chat-open-btn" id="yumi-open" type="button" aria-haspopup="dialog" aria-controls="yumi-dialog">Tirar dúvida</button>
  </div>
  <div class="read-progress" aria-hidden="true"></div>
</header>
<dialog class="yumi-dialog" id="yumi-dialog" aria-labelledby="yumi-title">
  <div class="yumi-head">
    <div><p class="yumi-kicker">PontaPé</p><h2 id="yumi-title">Converse com a Yumi</h2></div>
    <button class="icon-btn" type="button" data-close aria-label="Fechar conversa"><Icon name="close" /></button>
  </div>
  <div class="yumi-messages" id="yumi-messages" role="log" aria-live="polite" aria-relevant="additions text">
    <p class="yumi-message yumi-message--assistant">Sou a Yumi, AI do PontaPé. Esta conversa não é guardada. Ela fica só nesta aba enquanto você a usa.</p>
  </div>
  <form class="yumi-form" id="yumi-form">
    <label for="yumi-input">Sua dúvida</label>
    <textarea id="yumi-input" name="message" rows="2" maxlength="600" required placeholder="Escreva aqui. Enter envia."></textarea>
    <div class="yumi-form-bottom"><p id="yumi-status" role="status" aria-live="polite"></p><button class="btn btn--ink" type="submit">Enviar</button></div>
  </form>
</dialog>
