---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { PROJECT_NAME } from '../../data/site/project';

interface Props { current?: 'home' | 'transparencia' }
const { current = 'home' } = Astro.props;
const onHome = current === 'home';
const at = (hash: string) => (onHome ? hash : `/${hash}`);
const links = [
  { href: '/transparencia', label: 'Livro', current: current === 'transparencia' },
  { href: at('#dinheiro'), label: 'Dinheiro' },
  { href: at('#como-funciona'), label: 'Como funciona' },
  { href: at('#modulos'), label: 'Módulos' },
  { href: at('#gargalos'), label: 'Gargalos' },
  { href: at('#contribuicoes'), label: 'Contribuir' },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="logo" href="/" aria-label={`${PROJECT_NAME}, início`}>
      <LogoMark /><span class="logo-name">{PROJECT_NAME}</span><span class="logo-path" aria-hidden="true">/ {onHome ? 'início' : 'livro'}</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Principal">
      <ul>
        {links.map(l => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="icon-btn" id="text-size-btn" type="button" aria-pressed="false" title="Aumentar o texto"><span aria-hidden="true">A+</span><span class="sr-only">Texto maior</span></button>
    <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><Icon name="menu" /><span>Menu</span></button>
  </div>
</header>
