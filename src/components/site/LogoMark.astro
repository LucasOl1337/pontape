---
import { LOGO_RECTS, LOGO_VIEWBOX } from '../../lib/share/logo';

// Same three blocks as the favicon and the share card; Prisma paints them with the theme (css).
---
<svg class="logo-mark" viewBox={`0 0 ${LOGO_VIEWBOX.width} ${LOGO_VIEWBOX.height}`} aria-hidden="true" focusable="false">
  {LOGO_RECTS.map((r, i) => <rect class={`logo-b${i + 1}`} x={r.x} y={r.y} width={r.width} height={r.height} rx="2.5" />)}
</svg>
