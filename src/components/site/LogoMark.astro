---
import { LOGO_RECTS, LOGO_STROKE, LOGO_VIEWBOX } from '../../lib/share/logo';
---
<svg class="logo-mark" viewBox={`0 0 ${LOGO_VIEWBOX.width} ${LOGO_VIEWBOX.height}`} aria-hidden="true" focusable="false">
  {LOGO_RECTS.map(r => <rect x={r.x} y={r.y} width={r.width} height={r.height} rx="2" fill={r.fill} stroke={LOGO_STROKE} stroke-width="2" />)}
</svg>
