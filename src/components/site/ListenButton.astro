---
import Icon from './Icon.astro';

// Reads aloud the element with id `target` (its data-speech), or `speech` when given.
interface Props { target?: string; speech?: string; big?: boolean }
const { target, speech, big = false } = Astro.props;
---
{big
  ? <button class="voice-btn" type="button" data-listen={target} data-speech={speech} aria-pressed="false">
      <span class="voice-ring" aria-hidden="true"></span><span class="voice-core"><Icon name="speaker" /><span class="label">Ouvir</span></span>
    </button>
  : <button class="listen-btn" type="button" data-listen={target} data-speech={speech} aria-pressed="false">
      <Icon name="speaker" /><span class="label">Ouvir</span>
    </button>}
