---
const palettes = [
  ['jornal', 'Jornal'], ['anil', 'Anil'], ['pauta', 'Pauta'],
  ['envelope', 'Envelope'], ['pessego', 'Pêssego'], ['carvao', 'Carvão'],
] as const;
---
<div class="palette-switcher" data-palette-switcher>
  <button class="palette-trigger" type="button" aria-expanded="false" aria-controls="palette-options" data-palette-trigger>
    Cores <span>em teste</span>
  </button>
  <div class="palette-panel" id="palette-options" hidden data-palette-panel>
    <fieldset>
      <legend>Escolha as cores do site</legend>
      <p>A gente tá testando seis jeitos. Escolha o que preferir.</p>
      <div class="palette-options">
        {palettes.map(([id, name]) => <label class="palette-option" data-swatch={id}>
          <input type="radio" name="palette" value={id} />
          <span class="palette-sample" aria-hidden="true"><i></i><b></b></span>
          <span>{name}</span>
        </label>)}
      </div>
    </fieldset>
  </div>
</div>
<script>import '../../scripts/palette';</script>
<style>
  :global(body:has(.palette-switcher)){ padding-bottom:4.5rem }
  .palette-switcher{ position:fixed; z-index:150; left:1rem; bottom:1rem; font:700 .875rem/1.2 var(--font-sans) }
  .palette-trigger{ min-height:44px; display:flex; align-items:center; gap:.55rem; padding:.55rem .75rem; border:2px solid var(--ink); background:var(--paper); color:var(--ink); box-shadow:3px 3px 0 var(--ink); cursor:pointer }
  .palette-trigger span{ font-size:.6875rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--red) }
  .palette-trigger:hover{ background:var(--paper-2) }
  .palette-panel{ position:absolute; left:0; bottom:calc(100% + .75rem); width:min(20rem, calc(100vw - 2rem)); max-height:calc(100dvh - 6rem); overflow:auto; padding:1rem; border:2px solid var(--ink); background:var(--paper); color:var(--ink); box-shadow:5px 5px 0 var(--ink) }
  fieldset{ margin:0; padding:0; border:0; min-width:0 }
  legend{ padding:0; font:500 1.3rem/1.2 var(--font-display) }
  p{ margin:.3rem 0 .8rem; color:var(--ink-2); font:400 .875rem/1.4 var(--font-sans) }
  .palette-options{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem }
  .palette-option{ min-height:48px; display:flex; align-items:center; gap:.45rem; padding:.35rem; border:1px solid var(--rule); cursor:pointer }
  .palette-option:has(input:checked){ border:2px solid var(--red); padding:calc(.35rem - 1px) }
  .palette-option:has(input:focus-visible){ outline:3px solid var(--red); outline-offset:2px }
  .palette-option input{ position:absolute; opacity:0; width:1px; height:1px }
  .palette-sample{ display:flex; flex-shrink:0; width:2rem; height:2rem; border:1px solid var(--rule); background:var(--paper) }
  .palette-sample i{ width:50%; background:var(--ink) }
  .palette-sample b{ width:50%; background:var(--red) }
  @media (max-width:599px){
    .palette-switcher{ left:0; right:0; bottom:0; padding:.5rem 1rem; background:var(--paper); border-top:1px solid var(--rule) }
    .palette-panel{ left:1rem; bottom:calc(100% + .5rem) }
  }
  @media print{ .palette-switcher{ display:none } :global(body:has(.palette-switcher)){ padding-bottom:0 } }
</style>
