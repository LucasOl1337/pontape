---
import ListenButton from './ListenButton.astro';

interface Props { number: string; label: string; listen?: string; speech?: string }
const { number, label, listen, speech } = Astro.props;
---
<div class="eyebrow-row">
  <p class="eyebrow"><span class="eyebrow-num">{number}</span>{label}</p>
  {(listen || speech) && <ListenButton target={listen} speech={speech} />}
</div>
