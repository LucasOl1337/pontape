---
import Icon from '../site/Icon.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { NOW_LEAD, STEPS } from '../../data/site/journey';
import { MODULES } from '../../data/site/modules';
import { STATUSES, type ModuleStatus } from '../../data/site/statuses';
import type { IconName } from '../site/icon-names';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const statusOf = (id: string) => MODULES.find(m => m.id === id)!.status;

// The staircase is the page: the ground (what this is, for whoever just arrived), the 7 steps of the
// journey (PRD §4), each saying if it works yet, and the landing at the top (how to help). Each tread
// is a tab; its panel shows in place. The builder words live in the Construir caderno (F29).
const LAST = STEPS.length + 1;
// From the conversation on, the AI goes along and never stops (D028): a handrail on the staircase,
// from the Conversa tread past the top (F34).
const RAIL_FROM = STEPS.findIndex(s => s.module === 'M4') + 1;
const treads: { name: string; icon?: IconName }[] = [
  { name: 'Início' },
  ...STEPS.map(s => ({ name: s.shortName, icon: s.icon })),
  { name: 'Sua vez', icon: 'people' },
];
const ways: { icon: IconName; title: string; status: ModuleStatus; lead: string; when: string; href?: string; link?: string }[] = [
  { icon: 'coin', title: 'Doar', status: 'planned', lead: 'Ainda não abriu.', when: 'Abre quando tiver conta oficial.' },
  { icon: 'people', title: 'Ser voluntário', status: 'planned', lead: 'Ainda não abriu.', when: 'Abre quando começar na primeira cidade.' },
  { icon: 'briefcase', title: 'Oferecer vaga', status: 'planned', lead: 'Ainda não abriu.', when: 'Abre quando as primeiras pessoas entrarem.' },
  { icon: 'code', title: 'Construir junto', status: 'live', lead: 'Já dá pra ajudar.', when: 'Tem tarefa de código, design, pesquisa e mais.', href: '/construir', link: 'Ver como' },
];
---
<section class="stage" id="inicio" aria-labelledby="stage-title" data-escada data-at="0" style={`--n:${treads.length}`}>
  <h1 id="stage-title" class="stage-title">O primeiro passo pra quem quer <em>mudar de vida.</em></h1>

  <div class="stair" id="como-funciona" role="tablist" aria-label="Os degraus do projeto. Use as setas pra subir e descer." data-stair>
    {treads.map((t, k) => (
      <button class:list={['tread', { 'is-ahead': k > 0, 'on-rail': k >= RAIL_FROM, 'rail-start': k === RAIL_FROM }]} type="button" role="tab" id={`degrau-tab-${k}`} aria-controls={`degrau-${k}`}
        aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1} style={`--k:${k}`}>
        <span class="tread-block">
          {k === 0
            ? <svg class="tread-ball" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="21" /><path d="M24 16.5l7.1 5.2-2.7 8.4h-8.8l-2.7-8.4ZM24 16.5V3M31.1 21.7l12.8-4.2M28.4 30.1l7.9 10.9M19.6 30.1l-7.9 10.9M16.9 21.7 4.1 17.5" /></svg>
            : <Icon name={t.icon!} class="tread-icon" />}
        </span>
        <span class="tread-label">{k > 0 && k <= STEPS.length && <span class="tread-num">{k}</span>}<span class="tread-name">{t.name}</span></span>
      </button>
    ))}
    <span class="walker" aria-hidden="true"><span class="walker-label">alguém</span></span>
    <span class="rail" aria-hidden="true"><Icon name="voice-ai" /><span class="rail-label">a IA vai junto, sempre e de graça</span></span>
  </div>
  <p class="sr-only">Da conversa em diante, a IA vai junto da pessoa em todos os passos e continua depois do trabalho, sem prazo e de graça.</p>

  <div class="panels">
    <!-- Ground: what it is, why trust it, what to do now and whether it works yet. -->
    <div class="panel is-active" id="degrau-0" role="tabpanel" aria-labelledby="degrau-tab-0" tabindex="0" data-panel="0">
      <p class="panel-text">A gente dá comida, roupa e higiene nos primeiros dias. E ajuda a achar trabalho. Tudo o que a gente faz fica à vista de qualquer pessoa.</p>
      <p class="now now--building"><Icon name={STATUSES.building.icon} /><span><strong>Ainda em construção.</strong> Por enquanto, ninguém é atendido e nenhuma doação é recebida.</span></p>
      <div class="panel-nav">
        <button class="btn btn--ink" type="button" data-go="1">Ver como funciona<Icon name="arrow-right" /></button>
        <button class="btn" type="button" data-go={LAST}>Quero ajudar</button>
      </div>
    </div>

    {STEPS.map((s, i) => {
      const k = i + 1;
      const status = statusOf(s.module);
      const lead = NOW_LEAD[status];
      const prev = treads[k - 1]!, next = treads[k + 1]!;
      return (
        <div class="panel" id={`degrau-${k}`} role="tabpanel" aria-labelledby={`degrau-tab-${k}`} tabindex="0" data-panel={k}>
          <p class="panel-kicker">Passo {k} de {STEPS.length}</p>
          <h2 class="panel-title">{s.title}</h2>
          <p class="panel-text">{s.text}</p>
          <p class:list={['now', `now--${status}`]}><Icon name={STATUSES[status].icon} /><span><strong>{lead}</strong>{s.now.slice(lead.length)}</span></p>
          {k === STEPS.length && (
            <p class="panel-ledger">Até hoje: <strong>{ledger.events.length}</strong> ações anotadas e <strong>{brl.format(snapshot.receivedCents / 100)}</strong> recebido. <a href="/transparencia">Abrir o livro<Icon name="arrow-right" /></a></p>
          )}
          <div class="panel-nav">
            <button class="btn" type="button" data-go={k - 1}><Icon name="arrow-left" /><span>{prev.name}</span></button>
            <button class="btn btn--ink" type="button" data-go={k + 1}><span>{next.name}</span><Icon name="arrow-right" /></button>
            <button class="link-btn panel-more" type="button" data-module={s.module} aria-haspopup="dialog">Mais detalhes</button>
          </div>
        </div>
      );
    })}

    <!-- The landing: how to help. -->
    <div class="panel" id={`degrau-${LAST}`} role="tabpanel" aria-labelledby={`degrau-tab-${LAST}`} tabindex="0" data-panel={LAST}>
      <p class="panel-kicker">O topo da escada</p>
      <h2 class="panel-title">Sua vez. <em>Tem lugar aqui.</em></h2>
      <ul class="panel-ways">
        {ways.map(w => (
          <li><Icon name={w.icon} class="way-icon" />
            <span class="way-title">{w.title}</span>
            <span class="way-when"><strong class={`now--${w.status}`}>{w.lead}</strong> {w.when}{w.href && <> <a href={w.href}>{w.link}</a></>}</span></li>
        ))}
      </ul>
      <p class="panel-note"><Icon name="lock" />A gente não guarda contato de ninguém por enquanto.</p>
      <div class="panel-nav">
        <button class="btn" type="button" data-go={LAST - 1}><Icon name="arrow-left" /><span>{treads[LAST - 1]!.name}</span></button>
        <button class="btn" type="button" data-go="0"><Icon name="undo" /><span>Voltar ao início</span></button>
      </div>
    </div>
  </div>
</section>
