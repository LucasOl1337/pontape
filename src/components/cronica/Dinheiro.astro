---
import Icon from '../site/Icon.astro';
import ChapterHead from './ChapterHead.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import { OUT_CATEGORIES } from '../../lib/ledger-view/phrases';
import { formatCents, sumMoney } from '../../lib/ledger-view/money';

interface Props { real: LedgerEvent[]; example: LedgerEvent[] }
const { real, example } = Astro.props;
const panels = [{ mode: 'real', totals: sumMoney(real) }, { mode: 'example', totals: sumMoney(example) }] as const;
---
<section class="chapter chapter--paper" id="dinheiro" aria-labelledby="t-money"
  data-speech="Quanto entrou, quanto saiu e pra onde foi. Hoje entrou zero real e saiu zero real. A doação só abre quando existir uma conta oficial do projeto. Aqui nunca vai ter número inventado.">
  <div class="wrap">
    <ChapterHead id="t-money" kicker="Dinheiro" title="Quanto entrou, quanto saiu," turn="pra onde foi." listen="dinheiro" />
    <p class="standfirst">Até o custo pra manter o projeto de pé aparece aqui.</p>
    {panels.map(({ mode, totals }) => (
      <div class="money" data-money={mode} hidden={mode !== 'real'}>
        {mode === 'example' && <p class="sample-banner">Exemplo · valores fictícios.</p>}
        <dl class="money-totals">
          <div><dt>Entrou</dt><dd data-total-in>{formatCents(totals.inCents)}</dd></div>
          <div><dt>Saiu</dt><dd>{formatCents(totals.outCents)}</dd></div>
          <div class="is-balance"><dt>Em caixa</dt><dd data-total-balance>{formatCents(totals.balanceCents)}</dd></div>
        </dl>
        <div class="money-where">
          <h3>Pra onde foi</h3>
          <ul class="bars">
            {OUT_CATEGORIES.map(c => {
              const value = totals.outByCategory[c.id] ?? 0n;
              const share = totals.outCents > 0n ? Number((value * 1000n) / totals.outCents) / 10 : 0;
              return (
                <li>
                  <span class="bar-name"><Icon name={c.icon} />{c.name}</span>
                  <span class="bar-track" aria-hidden="true"><span class:list={['bar-fill', { 'has-value': value > 0n }]} style={`--p:${share}%`}></span></span>
                  <span class="bar-value">{formatCents(value)}<small>{Math.round(share)}%</small></span>
                </li>
              );
            })}
          </ul>
        </div>
        {mode === 'real' && totals.inCents === 0n && (
          <aside class="why-zero">
            <p class="kicker">Nota da redação</p>
            <h3>Por que está zerado?</h3>
            <p>A doação só abre quando existir uma conta oficial do projeto. Assim todo real tem dono, nota e prestação de contas. Aqui nunca vai ter número inventado. <a href="/#gargalo-receber-doacao-do-jeito-certo">Ver esse gargalo</a></p>
          </aside>
        )}
      </div>
    ))}
  </div>
</section>
