---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { TYPES } from '../../lib/ledger-view/phrases';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const events = ledger.events;
const last = events.at(-1);
const shortHash = (h: string) => `${h.slice(0, 4)} ${h.slice(4, 8)}`;
const recorded = last && new Date(last.recordedAt);
const recordedText = recorded && `${recorded.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}, às ${recorded.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' })}`;
// The last four links of the chain, oldest on the left, drawn when the page opens.
const art = events.slice(-4);
const LINK_W = 200, GAP = 40;
const speech = `Livro público. Tudo que o projeto faz, à vista. ${events.length ? `Hoje o livro tem ${events.length} ações.` : 'O livro oficial ainda não foi publicado.'} Dinheiro: entrou zero real e saiu zero real, porque a doação ainda não abriu. Toda ação aparece. Quem é a pessoa, não.`;
---
<section class="capa capa--livro" id="livro" aria-labelledby="page-title" data-speech={speech}>
  <div class="wrap">
    <div class="nameplate nameplate--caderno">
      <p class="nameplate-row"><span>Caderno especial</span><span>Transparência total</span></p>
      <p class="nameplate-name">Livro público</p>
    </div>
    <h1 id="page-title" class="capa-title">Tudo que o projeto faz, <em>à vista.</em></h1>
    <p class="deck capa-deck">Cada ação entra aqui: dinheiro, entrega na rua, passo de candidato e decisão do projeto. Cada linha fica presa na anterior. Qualquer pessoa confere, sem pedir licença.</p>
    <div class="byline"><span class="rule-inline"><Icon name="shield" />Toda ação aparece. Quem é a pessoa, não.</span><ListenButton target="livro" /></div>

    <figure class="capa-art capa-art--chain">
      {art.length > 0 ? (
        <svg class="line-art" viewBox={`0 0 ${art.length * LINK_W + (art.length - 1) * GAP + 20} 150`} aria-hidden="true" focusable="false">
          {art.map((e, i) => {
            const x = 10 + i * (LINK_W + GAP);
            return (
              <g class="pop-in" style={`--i:${i}`}>
                <rect x={x} y="30" width={LINK_W} height="72" rx="36" class="draw-in" pathLength="1" />
                {i > 0 && <path d={`M${x - GAP - 26} 66h${GAP + 52}`} class="link-bar" />}
                <text class="art-seq" x={x + LINK_W / 2} y="60">nº {e.sequence}</text>
                <text class="art-hash" x={x + LINK_W / 2} y="86">{shortHash(e.hash)}</text>
                <text class="art-type" x={x + LINK_W / 2} y="134">{TYPES[e.payload.type].label}</text>
              </g>
            );
          })}
        </svg>
      ) : <p class="chain-empty-title">O livro oficial ainda não foi publicado.</p>}
      {art.length > 0 && <figcaption>As últimas {art.length} ações do livro. Cada uma guarda a marca da anterior.</figcaption>}
    </figure>

    <section class="numbers" aria-labelledby="numbers-title">
      <h2 class="numbers-title" id="numbers-title">O livro hoje</h2>
      <dl class="numbers-grid">
        <div><dt>Ações no livro</dt><dd>{events.length}</dd></div>
        <div><dt>Entrou</dt><dd>{brl.format(snapshot.receivedCents / 100)}</dd></div>
        <div><dt>Saiu</dt><dd>{brl.format(snapshot.spentCents / 100)}</dd></div>
        <div><dt>Marca mais recente</dt><dd class="mono">{last ? shortHash(last.hash) : 'nenhuma'}</dd></div>
      </dl>
      <p class="numbers-note">{last
        ? `Livro estático. Última ação registrada em ${recordedText}. A página é refeita sempre que entra uma ação nova.`
        : 'O livro oficial ainda não foi publicado. Quando for, aparece aqui a hora da última ação registrada. Nada nesta página se chama ao vivo enquanto não for.'}</p>
    </section>
  </div>
</section>
