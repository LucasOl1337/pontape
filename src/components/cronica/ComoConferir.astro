---
import Icon from '../site/Icon.astro';
import { canonicalize } from '../../lib/ledger/canonical';
import { ledgerTrust, latestAnchor } from '../../lib/ledger/published';
import type { LedgerView } from '../../lib/ledger-view/source';
import { phrase } from '../../lib/ledger-view/phrases';
import { REPOSITORY_OPEN } from '../../data/site/project';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const events = ledger.events;
const last = events.at(-1);
const shortHash = (h: string) => `${h.slice(0, 4)} ${h.slice(4, 8)}`;
const groups = (h: string) => h.match(/.{1,8}/g)!.join(' ');

// The real text of the newest action, exactly as it goes into SHA-256 (F08 canonical form),
// with the previous action's mark picked out: that is the link of the chain.
let text = { before: '', mark: '', after: '' };
if (last) {
  const unsigned: Partial<typeof last> = { ...last };
  delete unsigned.hash;
  const full = canonicalize(unsigned);
  const at = full.indexOf(last.previousHash);
  text = { before: full.slice(0, at), mark: last.previousHash, after: full.slice(at + last.previousHash.length) };
}
const links = events.slice(-3);

const TRUST = [
  { label: 'Quem assina', value: 'Regente · Ed25519' },
  { label: 'Última marca assinada', value: latestAnchor ? `até a ação nº ${latestAnchor.sequence}` : 'nenhuma ainda' },
  { label: 'Carimbo de tempo público', value: ledgerTrust.timestamp.status === 'confirmed' ? 'confirmado no Bitcoin' : ledgerTrust.timestamp.status === 'pending' ? 'pendente de confirmação no Bitcoin' : 'ainda não feito' },
  { label: 'Cópia fora do projeto', value: 'ainda não ativa' },
];
const STEPS = [
  { title: 'Cada ação vira um texto padrão.', text: `Sempre os mesmos campos, na mesma ordem. Sem nome de ninguém.${last ? ` Ao lado, o texto da ação nº ${last.sequence}, do jeito exato que entra na conta.` : ''}` },
  { title: 'O texto vira uma marca.', text: 'Uma conta pública, a SHA-256, transforma o texto numa marca. Mudou uma vírgula, a marca muda inteira.' },
  { title: 'Cada marca segura a anterior.', text: `A ação nova leva junto a marca da anterior.${last ? ' Ela está em vermelho no texto.' : ''} Mexer numa linha antiga quebra todas as marcas depois dela.` },
];
---
<div class="proof-grid">
  <ol class="mini-stair" style={`--n:${STEPS.length}`}>
    {STEPS.map((step, k) => (
      <li style={`--k:${k}`}><span class="mini-num">{k + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>
    ))}
  </ol>
  {last && (
    <div class="proof" aria-label={`A ação nº ${last.sequence} por dentro`}>
      <div class="proof-doc">
        <p class="proof-label"><span class="mini-num">1</span>Texto da ação nº {last.sequence} · {phrase(last.payload)}</p>
        <p class="proof-text">{text.before}<mark>{text.mark}</mark>{text.after}</p>
      </div>
      <div class="proof-hash">
        <p class="proof-label"><span class="mini-num">2</span>Marca da ação nº {last.sequence} · SHA-256</p>
        <p class="proof-mark">{groups(last.hash)}</p>
      </div>
      <ol class="proof-chain" aria-label="3: a corrente">
        {links.map(e => (
          <li>
            <span class="proof-seq">nº {e.sequence}</span>
            <span class="proof-own">{shortHash(e.hash)}</span>
            <span class="proof-prev">guarda {e.sequence === '1' ? 'o começo' : shortHash(e.previousHash)}</span>
          </li>
        ))}
      </ol>
    </div>
  )}
</div>
<div class="fine-print">
  <aside class="not-proven">
    <p class="kicker">O que o livro não prova</p>
    <p>A conta confere se as ações combinam com suas marcas. A assinatura cobre só até a ação indicada abaixo. Isso não prova que tudo aconteceu ou foi registrado. Ainda precisamos da conferência com o extrato do banco e de auditoria de fora.</p>
  </aside>
  <dl class="trust-list" aria-label="Assinatura e carimbo do livro">
    {TRUST.map(t => <div><dt>{t.label}</dt><dd>{t.value}</dd></div>)}
  </dl>
  <p class="verify-cli">Chave pública do Regente: <code style="overflow-wrap:anywhere">{ledgerTrust.signature.publicKey}</code></p>
  <p class="verify-cli">Compare esta chave com uma cópia obtida fora do site e do repositório. Esse canal independente ainda não foi publicado. O botão confere a assinatura; não consulta o Bitcoin.</p>
  {latestAnchor && <div class="actions">
    <a class="btn" href={`/livro/ancoras/${latestAnchor.signedCheckpoint.file}`} download>Baixar marca assinada nº {latestAnchor.sequence}</a>
    <a class="btn" href={`/livro/ancoras/${latestAnchor.proofs.at(-1)!.file}`} download>Baixar prova OpenTimestamps</a>
    <a href="/livro/ancoras/index.json">Histórico de âncoras</a>
  </div>}
  <details class="more-details">
    <summary>Baixar o livro e conferir no seu computador</summary>
    <div class="actions">
      <a class="btn" href="/livro/ledger.json" download="livro.json"><Icon name="download" />Baixar o livro inteiro</a>
      <a class="btn" href="/livro/checkpoint.json" download="marca-de-controle.json"><Icon name="shield" />Baixar a marca de controle</a>
    </div>
    <p class="verify-cli">Guarde a marca de controle num lugar seu. Numa próxima visita, ela mostra se alguém refez o livro. No computador, o verificador aberto confere tudo sem internet: <code>npm run ledger:verify</code>, com o passo a passo em <code>docs/transparencia/COMO-CONFERIR.md</code>.{!REPOSITORY_OPEN && ' O repositório ainda está fechado.'}</p>

  </details>
</div>
