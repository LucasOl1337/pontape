---
import { PLAIN } from '../../data/site/livro';

// One drawing (F42 E1): four actions, each link holding the one before, the last one
// ready for the Bitcoin stamp. The caption says what the picture means.
const SHEETS = [0, 1, 2, 3];
const x = (i: number) => 2 + i * 92;
---
<figure class="corrente">
  <svg class="corrente-art" viewBox="0 0 372 58" aria-hidden="true" focusable="false">
    {SHEETS.map(i => (
      <g>
        {i > 0 && <g class="c-link"><rect x={x(i) - 29} y="25" width="16" height="9" rx="4.5" /><rect x={x(i) - 18} y="25" width="16" height="9" rx="4.5" /></g>}
        <rect class="c-sheet" x={x(i)} y="8" width="64" height="44" rx="2" />
        <path class="c-lines" d={`M${x(i) + 8} 20h36M${x(i) + 8} 28h40M${x(i) + 8} 36h28`} />
        {i === SHEETS.length - 1 && (
          <g class="c-bitcoin">
            <circle cx={x(i) + 58} cy="16" r="11" />
            <circle cx={x(i) + 58} cy="16" r="6.5" />
          </g>
        )}
      </g>
    ))}
  </svg>
  <figcaption class="corrente-label">{PLAIN.chain}</figcaption>
</figure>
