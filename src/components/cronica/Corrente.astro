---
import Icon from '../site/Icon.astro';
import { PLAIN } from '../../data/site/livro';

// The book told in five steps (D038, no coin anywhere), redone on 02/10 for someone who never heard
// of a hash: the mark is a seal with a shape, not a code. The three lines are always on screen, so
// nothing jumps; each step lights up what it explains. scripts/corrente.ts only sets data-scene and
// the selected step. Without JS the whole good chain and every step are shown.
const SCENES = PLAIN.scenes;
// The shape inside each seal. Line 1 has a second one: the mark it gets when someone changes it.
const GLYPH = {
  tri: 'M12 6.5l6 10.5H6z',
  square: 'M7.5 7.5h9v9h-9z',
  diamond: 'M12 5.5l6.5 6.5-6.5 6.5-6.5-6.5z',
  changed: 'M12 6.5a5.5 5.5 0 1 0 0 11a5.5 5.5 0 1 0 0-11zm0 3a2.5 2.5 0 1 1 0 5a2.5 2.5 0 1 1 0-5z',
} as const;
const lines = [
  { n: 1, what: 'Entrou uma doação pelo site', amount: 'R$ 50', glyph: GLYPH.tri },
  { n: 2, what: 'Comprou 5 kits de higiene', amount: 'R$ 48', glyph: GLYPH.square, prev: GLYPH.tri },
  { n: 3, what: 'Entregou os 5 kits na praça', amount: '5 kits', glyph: GLYPH.diamond, prev: GLYPH.square },
];
const seal = (d: string, extra = '') => `<svg viewBox="0 0 24 24" focusable="false"><path class="cr-g ${extra}" d="${d}"/></svg>`;
---
<figure class="corrente" data-corrente data-scene="all" aria-labelledby="corrente-title">
  <p class="cr-example">Exemplo fictício pra explicar o livro.</p>
  <div class="cr-steps" data-controls hidden>
    {SCENES.map((s, i) => (
      <button type="button" class="cr-step" data-scene-go={i + 1} aria-current={i === 0 ? 'step' : undefined}>
        <span class="cr-step-num">{i + 1}</span><span class="cr-step-label">{s.short}</span>
      </button>
    ))}
  </div>

  <div class="cr-stage" aria-hidden="true">
    <ol class="cr-chain">
      {lines.map((l, i) => (
        <>
          {i > 0 && <li class={`cr-link cr-link-${i}`}><Icon name="link" /></li>}
          <li class={`cr-card cr-card-${l.n}`}>
            <p class="cr-card-n">Linha {l.n}</p>
            <p class="cr-what">{l.what}</p>
            <p class="cr-amount">
              <span class="cr-amount-ok">{l.amount}</span>
              {l.n === 1 && <span class="cr-amount-bad">R$ 20</span>}
            </p>
            <div class="cr-marks">
              <p class="cr-prev">
                {l.prev
                  ? <><span>Marca da linha {l.n - 1}</span><span class="cr-seal cr-seal-mini" set:html={seal(l.prev)} /><b class="cr-nomatch">não bate</b></>
                  : <span>Primeira linha</span>}
              </p>
              <p class="cr-own">
                <span>Marca desta</span>
                <span class="cr-seal" set:html={seal(l.glyph, 'cr-g-ok') + (l.n === 1 ? seal(GLYPH.changed, 'cr-g-bad') : '')} />
              </p>
            </div>
          </li>
        </>
      ))}
    </ol>
    <div class="cr-registry">
      <span class="cr-seal cr-seal-mini" set:html={seal(GLYPH.diamond)} />
      <p><b>Registro público, fora do projeto</b><span>guardou a marca da linha 3 em 24/09/2026, às 14:18</span></p>
      <Icon name="check" class="cr-registry-ok" />
    </div>
  </div>

  <figcaption class="cr-caption">
    <p class="cr-now" data-live aria-live="polite">
      <span class="cr-now-num" data-scene-num>1</span>
      <span><b class="cr-now-title" id="corrente-title" data-scene-title>{SCENES[0]!.title}</b> <span data-scene-text>{SCENES[0]!.text}</span></span>
    </p>
    <ol class="corrente-all">
      {SCENES.map((s, i) => <li><span class="cr-now-num">{i + 1}</span><span><b>{s.title}</b> <span>{s.text}</span></span></li>)}
    </ol>
    <div class="cr-nav" data-nav hidden>
      <button class="cr-nav-btn" type="button" data-prev><Icon name="arrow-left" /><span>Voltar</span></button>
      <button class="cr-nav-btn" type="button" data-play aria-pressed="true"><Icon name="pause" /><span>Pausar</span></button>
      <button class="cr-nav-btn cr-nav-next" type="button" data-next><span>Próximo</span><Icon name="arrow-right" /></button>
    </div>
  </figcaption>
</figure>
<script>import '../../scripts/corrente';</script>
