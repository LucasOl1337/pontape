---
import Icon from '../site/Icon.astro';
import NotOpenBadge from '../site/NotOpenBadge.astro';
import Sheet from './Sheet.astro';
import { CONTRIBUTIONS, CONTRIBUTION_TYPES, issueUrl } from '../../data/site/contributions';
import { bottleneckTitle } from '../../data/site/bottlenecks';
import { REPOSITORY_OPEN } from '../../data/site/project';

// "Todas" shows the first HOME_LIMIT ads; the rest open with one button.
const HOME_LIMIT = 6;
const goodFirst = CONTRIBUTIONS.filter(c => c.goodFirst);
const types = (Object.keys(CONTRIBUTION_TYPES) as (keyof typeof CONTRIBUTION_TYPES)[])
  .map(t => ({ id: t, ...CONTRIBUTION_TYPES[t], count: CONTRIBUTIONS.filter(c => c.type === t).length }))
  .filter(t => t.count > 0);
---
<Sheet id="contribuicoes" kicker="Classificados" title="Precisa-se." turn="Onde você pode ajudar agora.">
    <p class="standfirst">Tarefas concretas, uma por anúncio. Cada uma diz o tipo, se é um bom primeiro passo e qual gargalo ela destrava.</p>
    <div class="filters" role="group" aria-label="Filtrar contribuições" data-contrib-filters>
      <button class="filter" type="button" data-contrib="all" aria-pressed="true">Todas<span class="count">{CONTRIBUTIONS.length}</span></button>
      <button class="filter" type="button" data-contrib="first" aria-pressed="false"><Icon name="sprout" />Bom primeiro passo<span class="count">{goodFirst.length}</span></button>
      {types.map(t => <button class="filter" type="button" data-contrib={t.id} aria-pressed="false"><Icon name={t.icon} />{t.label}<span class="count">{t.count}</span></button>)}
    </div>
    <ul class="ads" data-contrib-grid>
      {CONTRIBUTIONS.map((c, i) => {
        const unlocks = bottleneckTitle(c.bottleneck);
        return (
          <li class="ad contrib-card" data-type={c.type} data-first={String(c.goodFirst)} data-extra={i >= HOME_LIMIT ? 'true' : undefined} hidden={i >= HOME_LIMIT}>
            <p class="ad-head">
              <span class="ad-type"><Icon name={CONTRIBUTION_TYPES[c.type].icon} />{CONTRIBUTION_TYPES[c.type].label}</span>
              {c.goodFirst && <span class="ad-first"><Icon name="sprout" />Bom primeiro passo</span>}
            </p>
            <h3>{c.title}</h3>
            <p class="ad-summary">{c.summary}</p>
            <p class="ad-unlocks"><span class="module-id">{c.module}</span>
              {unlocks ? <span>Destrava: <a href={`#gargalo-${c.bottleneck}`}>{unlocks}</a></span> : <span>Melhora a plataforma</span>}
            </p>
            <p class="ad-foot"><a href={issueUrl(c.issueNumber)} rel="noopener">Issue #{c.issueNumber}<Icon name="arrow-right" /></a>{!REPOSITORY_OPEN && <span>Repositório ainda fechado</span>}</p>
          </li>
        );
      })}
    </ul>
    <div class="ads-more"><button class="btn" type="button" data-contrib-more>Mostrar os {CONTRIBUTIONS.length} anúncios</button></div>
    <p class="soon-note"><NotOpenBadge /><span>Cada anúncio já é uma issue no GitHub. Pegar uma tarefa abre junto com o repositório.</span></p>
</Sheet>
