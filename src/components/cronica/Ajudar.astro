---
import Icon from '../site/Icon.astro';
import Badge from '../site/Badge.astro';
import ChapterHead from './ChapterHead.astro';

const ways = [
  { icon: 'coin', title: 'Doar', text: 'Seu dinheiro vira comida, roupa e higiene. E cada real aparece no livro público.', status: 'planned', when: 'Abre quando a conta oficial do projeto existir.', link: { href: '#gargalo-receber-doacao-do-jeito-certo', label: 'Entender por quê' } },
  { icon: 'people', title: 'Ser voluntário', text: 'Vá até a pessoa com o aparelho da conversa. A gente treina você antes.', status: 'planned', when: 'Abre com o piloto na primeira cidade.' },
  { icon: 'briefcase', title: 'Oferecer vaga', text: 'Dê a primeira chance pra alguém que chegou preparado e quer muito trabalhar.', status: 'planned', when: 'Abre quando as primeiras pessoas forem escolhidas.' },
  { icon: 'code', title: 'Contribuir', text: 'Código, design, pesquisa, campo, direito. Tem espaço pra muita coisa.', status: 'building', when: 'As tarefas já estão nos classificados. Pegar uma abre junto com o repositório.', link: { href: '#contribuicoes', label: 'Ver os classificados' } },
] as const;
---
<section class="chapter" id="ajudar" aria-labelledby="t-help"
  data-speech="Tem quatro jeitos de ajudar: doar, ser voluntário, oferecer uma vaga ou contribuir com o projeto. A doação, o voluntariado e as vagas ainda não abriram. As contribuições já estão listadas, e pegar uma abre junto com o repositório. A gente não guarda contato de ninguém por enquanto.">
  <div class="wrap">
    <ChapterHead id="t-help" kicker="Como entrar nesta história" title="Tem lugar" turn="pra você aqui." listen="ajudar" />
    <p class="standfirst">Quatro jeitos de entrar. Cada um diz, sem enrolação, se já dá pra começar.</p>
    <ul class="ways">
      {ways.map(w => (
        <li class="way">
          <Icon name={w.icon} class="way-icon" />
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <p class="way-status">{w.status === 'planned' ? <span class="badge badge--planned"><Icon name="clock" />Ainda não abriu</span> : <Badge status={w.status} />}<span>{w.when}</span></p>
          {'link' in w && <a class="more-link" href={w.link.href}>{w.link.label}<Icon name="arrow-right" /></a>}
        </li>
      ))}
    </ul>
    <p class="data-note"><Icon name="lock" /><span>A gente não guarda contato de ninguém por enquanto. Lista de aviso e formulário só quando existir um responsável legal pelos dados.</span></p>
  </div>
</section>
