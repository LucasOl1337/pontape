---
import Icon from '../site/Icon.astro';
import PublicMetrics from '../site/PublicMetrics.astro';
import Corrente from './Corrente.astro';
import LedgerData from '../ledger/LedgerData.astro';
import VerifyPanel from '../ledger/VerifyPanel.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { recentLines } from '../../lib/ledger-view/plain';
import { decisionPlain } from '../../data/site/decisions';
import { LIVRO, PLAIN } from '../../data/site/livro';

// First layer of /transparencia, one screen (F42): the chain told in five scenes on one side,
// the seal that redoes the sums on the other, the numbers under it. What happened lately and
// the way to the technical page come after, for whoever scrolls.
interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const events = ledger.events;
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const last = events.at(-1);
const zone = { timeZone: 'America/Sao_Paulo' } as const;
const recorded = last && new Date(last.recordedAt);
const lastText = recorded && `A última entrou em ${recorded.toLocaleDateString('pt-BR', { ...zone, day: '2-digit', month: '2-digit' })}, às ${recorded.toLocaleTimeString('pt-BR', { ...zone, hour: '2-digit', minute: '2-digit' })}.`;
const note = [lastText ?? PLAIN.empty, snapshot.receivedCents === 0 && !snapshot.donationsEnabled ? PLAIN.zero : ''].filter(Boolean).join(' ');
const numbers = [
  { label: events.length === 1 ? 'ação anotada' : 'ações anotadas', value: String(events.length) },
  { label: 'entrou', value: brl.format(snapshot.receivedCents / 100) },
  { label: 'saiu', value: brl.format(snapshot.spentCents / 100) },
];
const lines = recentLines(events, decisionPlain);
const shortDay = (iso: string) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}`;
---
<article class="plain" aria-labelledby="page-title">
  <div class="plain-top">
    <p class="kicker">Transparência</p>
    <a class="btn plain-tech" href={LIVRO.tecnico}><Icon name="code" />Parte técnica</a>
  </div>

  <div class="plain-screen">
    <header class="plain-head">
      <h1 id="page-title" class="plain-title">Tudo que o projeto faz, <em>à vista.</em></h1>
      <p class="plain-lead">{PLAIN.lead}</p>
    </header>
    <Corrente />
    <div class="plain-side">
      <section class="conferir" id="conferir" aria-labelledby="t-verify">
        <h2 id="t-verify" class="sr-only">Confira você mesmo</h2>
        <VerifyPanel data="ledger-real" where={PLAIN.verify} plain seal details={LIVRO.tecnico} />
        <LedgerData id="ledger-real" ledger={ledger} />
      </section>
      <div class="plain-numbers">
        <dl class="plain-count">
          {numbers.map(n => <div><dt>{n.label}</dt><dd>{n.value}</dd></div>)}
        </dl>
        <p class="plain-note">{note}</p>
        <PublicMetrics />
      </div>
    </div>
  </div>

  <section class="plain-recent" aria-labelledby="t-recent">
    <h2 id="t-recent" class="plain-h2">O que já aconteceu</h2>
    {lines.length
      ? <ol class="recent">
          {lines.map(l => (
            <li>
              <time datetime={l.day}>{shortDay(l.day)}</time>
              <p>{l.lead && <strong>{l.lead}</strong>} {l.text}</p>
              <button class="conferir-esta" type="button" data-verify-until={l.through}>{PLAIN.thisOne}</button>
            </li>
          ))}
        </ol>
      : <p class="plain-note">{PLAIN.empty}</p>}
    <a class="more-link" href={`${LIVRO.tecnico}#acoes`}>Ver todas, na parte técnica<Icon name="arrow-right" /></a>
  </section>

  <footer class="plain-end">
    <p>{PLAIN.end}</p>
    <a class="btn btn--ink" href={LIVRO.tecnico}><Icon name="code" />Parte técnica</a>
  </footer>
</article>
<style is:global>
  .seal{
    display:inline-flex; align-items:center; gap:.7rem; min-height:56px; padding:.3rem 1.15rem .3rem .3rem;
    border:2px solid var(--ink); border-radius:999px; background:var(--paper); color:var(--ink);
    font:700 1rem/1.2 var(--font-sans); cursor:pointer;
  }
  .seal:hover{ border-color:var(--accent); color:var(--accent) }
  .seal:disabled{ opacity:.55; cursor:progress }
  .seal-mark{
    display:grid; place-items:center; width:2.6rem; height:2.6rem; border-radius:50%;
    background:var(--accent); color:var(--paper);
  }
  .seal-mark .icon{ width:1.25rem; height:1.25rem }
  .proof-summary{ margin-top:var(--space-4); font:600 1.2rem/1.35 var(--font-serif) }
  .proof-steps{ display:grid; gap:.85rem; margin-top:var(--space-3) }
  .proof-step{ display:grid; grid-template-columns:1.7rem minmax(0, 1fr); gap:.7rem; align-items:start }
  .proof-mark{ width:1.7rem; height:1.7rem; margin-top:.1rem; border:2px solid var(--ink); border-radius:50% }
  .proof-step[data-mark="ok"] .proof-mark{ border-color:var(--status-ok-icon); background:var(--status-ok-icon); box-shadow:inset 0 0 0 3px var(--paper), inset 0 0 0 6px var(--status-ok-icon) }
  .proof-step[data-mark="bad"] .proof-mark{ border-color:var(--status-broken-icon); background:var(--status-broken-icon) }
  .proof-step[data-mark="later"] .proof-mark{ border-style:dashed; border-color:var(--ink-2) }
  .proof-step[data-mark="run"] .proof-mark{ border-color:var(--accent) }
  .proof-step-title{ font:600 1.05rem/1.3 var(--font-serif) }
  .proof-step p + p{ margin-top:.15rem; font:400 .95rem/1.4 var(--font-sans); color:var(--ink-2) }
  .proof-step a{ display:inline-flex; align-items:center; min-height:44px; font:700 .95rem/1.2 var(--font-sans); color:var(--accent) }
  .seal-extra{ display:flex; flex-wrap:wrap; gap:.25rem 1.2rem; align-items:center; margin-top:var(--space-3) }
  .seal-file{
    position:relative; display:inline-flex; align-items:center; min-height:44px;
    font:700 .9375rem/1.2 var(--font-sans); text-decoration:underline; text-underline-offset:.18em; cursor:pointer;
  }
  .seal-file input{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0) }
  .seal-file:focus-within{ outline:3px solid var(--accent); outline-offset:3px }
</style>
