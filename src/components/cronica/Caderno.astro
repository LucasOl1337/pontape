---
import Doors from './Doors.astro';
import { CADERNOS, CONSTRUIR, type Caderno } from '../../data/site/cadernos';

// A caderno is a page of its own (F31): the site header, the same grid as the rest of the site and
// one scroll. It used to open as a panel over the home, cut on the left and scrolling inside itself.
// The ones behind the door say where they sit and end with the other doors.
interface Props { id?: Caderno['id']; title: string; turn?: string; lead: string }
const { id, title, turn, lead } = Astro.props;
const here = id && CADERNOS.find(c => c.id === id);
const others = CADERNOS.filter(c => c.id !== id);
---
<article class="caderno" aria-labelledby="caderno-title">
  <header class="caderno-head">
    {here
      ? <nav class="crumbs" aria-label="Você está em"><ol><li><a href={CONSTRUIR.href}>{CONSTRUIR.name}</a></li><li aria-current="page">{here.short}</li></ol></nav>
      : <p class="kicker">{CONSTRUIR.name}</p>}
    <h1 id="caderno-title" class="caderno-title">{title}{turn && <> <em>{turn}</em></>}</h1>
    <p class="caderno-lead">{lead}</p>
  </header>
  <div class="caderno-body"><slot /></div>
  {here && (
    <nav class="caderno-more" aria-labelledby="caderno-more-title">
      <h2 id="caderno-more-title" class="caderno-more-title">Mais por dentro do projeto</h2>
      <Doors items={others} compact />
    </nav>
  )}
</article>
