---
import Icon from '../site/Icon.astro';
import { MODULES } from '../../data/site/modules';
import { BOTTLENECKS } from '../../data/site/bottlenecks';
import { CONTRIBUTIONS } from '../../data/site/contributions';

// The strip under the staircase, like the "nesta edição" of a front page: every other part of the
// project, one click away.
---
<nav class="edition" aria-label="Nesta edição">
  <p class="edition-label">Nesta edição</p>
  <ul class="edition-links">
    <li><a href="#modulos"><span class="edition-num">{MODULES.length}</span>peças</a></li>
    <li><a href="#gargalos"><span class="edition-num">{BOTTLENECKS.length}</span>gargalos</a></li>
    <li><a href="#contribuicoes"><span class="edition-num">{CONTRIBUTIONS.length}</span>tarefas abertas</a></li>
    <li><a href="/transparencia"><Icon name="shield" />Livro público</a></li>
    <li><a href="#codigo-aberto"><Icon name="code" />Código aberto</a></li>
  </ul>
</nav>
