---
import Icon from '../site/Icon.astro';
import Caderno from './Caderno.astro';
import { BOTTLENECKS } from '../../data/site/bottlenecks';
import { CONTRIBUTIONS, IDEA_URL, issueUrl } from '../../data/site/contributions';

// Five questions, all closed: the list fits the first screen. A link to one (#<id>) opens it.
---
<Caderno id="gargalos" title="O que a gente ainda" turn="não sabe resolver."
  lead={`Falar disso também é transparência. São ${BOTTLENECKS.length} perguntas em aberto. Se você entende de algum desses assuntos, sua ajuda vale muito.`}>
  <div class="questions">
    {BOTTLENECKS.map((b, i) => {
      const tasks = CONTRIBUTIONS.filter(c => c.bottleneck === b.id);
      return (
        <details class="question" id={b.id}>
          <summary>
            <span class="question-num" aria-hidden="true">{i + 1}</span>
            <span class="question-head"><span class="question-title">{b.title}</span><span class="module-id">{b.modules}</span></span>
            <Icon name="chevron-down" class="chevron" />
          </summary>
          <div class="question-body">
            <dl>
              <div><dt>Por que é difícil</dt><dd>{b.why}</dd></div>
              <div><dt>O que já está andando</dt><dd>{b.progress}</dd></div>
              <div><dt>Quem pode ajudar</dt><dd>{b.helpers}</dd></div>
            </dl>
            <div class="question-help">
              {tasks.length > 0 && (
                <div><p class="question-help-title">Tarefas pra isso</p>
                  <ul>{tasks.map(t => <li><a href={issueUrl(t.issueNumber)} rel="noopener">{t.title}</a></li>)}</ul></div>
              )}
              <div><p class="question-help-title">Tem uma ideia?</p>
                <p><a href={IDEA_URL} rel="noopener">Conte no GitHub<Icon name="arrow-right" /></a></p></div>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</Caderno>
<script>import '../../scripts/gargalos';</script>
