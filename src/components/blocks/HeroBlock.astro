---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import ChainStrip from '../ledger/ChainStrip.astro';
import ChainMap from '../ledger/ChainMap.astro';
import VerifyPanel from '../ledger/VerifyPanel.astro';
import LedgerData from '../ledger/LedgerData.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { TYPES, TYPE_ORDER } from '../../lib/ledger-view/phrases';
import { formatCents, sumMoney } from '../../lib/ledger-view/money';
import { PROJECT_NAME } from '../../data/site/project';
import { shortHash } from '../../scripts/hashprint';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const { events } = ledger;
// F02 snapshot says why money is still zero; the numbers themselves come from the ledger sums.
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const money = sumMoney(events);
const supported = events.reduce((n, { payload: p }) => p.type === 'candidate' && p.action === 'support_completed' ? n + BigInt(p.count) : n, 0n);
const last = events.at(-1);
const tz = { timeZone: 'America/Sao_Paulo' } as const;
const lastDay = last && new Date(last.recordedAt).toLocaleDateString('pt-BR', { ...tz, day: '2-digit', month: '2-digit', year: 'numeric' });
const lastTime = last && new Date(last.recordedAt).toLocaleTimeString('pt-BR', { ...tz, hour: '2-digit', minute: '2-digit' });
const byType = TYPE_ORDER.map(type => ({ type, count: events.filter(e => e.payload.type === type).length }));
const actions = (n: number) => `${n} ${n === 1 ? 'ação' : 'ações'}`;
const speech = `Aqui é o ${PROJECT_NAME}. O pontapé inicial pra quem quer mudar de vida. A gente encontra quem quer recomeçar. Garante comida, roupa e higiene nos primeiros dias. E ajuda a chegar num trabalho, com apoio de inteligência artificial. Tudo que a gente faz entra num livro público. Hoje ele tem ${actions(events.length)}. Entrou zero real e saiu zero real, porque a doação ainda não abriu. Qualquer pessoa pode conferir que nada foi apagado nem mudado. É um projeto sem fins lucrativos, com código aberto.`;
---
<section class="hero" id="inicio" aria-labelledby="hero-title" data-speech={speech}>
  <div class="hero-inner">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span class="kicker-dot" aria-hidden="true"></span>{PROJECT_NAME}<span aria-hidden="true">·</span>sem fins lucrativos<span aria-hidden="true">·</span>código aberto</p>
        <h1 id="hero-title">O pontapé inicial pra quem quer mudar de vida. <span class="h1-sub">Cada passo, à vista.</span></h1>
        <p class="lead">A gente encontra quem quer recomeçar, garante comida, roupa e higiene nos primeiros dias e ajuda a chegar num trabalho, com apoio de IA. Tudo que a gente faz entra num livro público. Qualquer pessoa confere.</p>
        <div class="actions">
          <a class="btn btn--primary" href="/transparencia">Abrir o livro público<Icon name="arrow-right" /></a>
          <a class="btn" href="#como-funciona">Como funciona</a>
          <ListenButton target="inicio" />
        </div>
      </div>

      <div class="hero-data">
        <form class="search" action="/transparencia" method="get" role="search" data-search>
          <label for="busca-acao">Procurar no livro</label>
          <div class="search-row">
            <Icon name="search" />
            <input id="busca-acao" name="acao" type="search" autocomplete="off" spellcheck="false" placeholder="nº ou marca, ex.: 12 ou 6597" aria-describedby="busca-dica" />
            <button class="btn btn--small" type="submit">Procurar</button>
          </div>
          <p class="search-hint sr-only" id="busca-dica">Digite o número de uma ação ou o começo da marca dela.</p>
        </form>
        <dl class="stats" aria-label="O livro hoje">
          <div class="stat stat--wide">
            <dt>Ações no livro</dt>
            <dd class="stat-value">{events.length}</dd>
            <dd class="type-bar" aria-hidden="true">{byType.filter(t => t.count).map(t => <span data-type={t.type} style={`flex:${t.count}`}></span>)}</dd>
            <dd class="type-counts">{byType.map(t => <span><span class="type-dot" data-type={t.type} aria-hidden="true"></span>{TYPES[t.type].label} {t.count}</span>)}</dd>
          </div>
          <div class="stat"><dt>Entrou</dt><dd class="stat-value">{formatCents(money.inCents)}</dd></div>
          <div class="stat"><dt>Saiu</dt><dd class="stat-value">{formatCents(money.outCents)}</dd></div>
          <div class="stat"><dt>Em caixa</dt><dd class="stat-value">{formatCents(money.balanceCents)}</dd></div>
          <div class="stat"><dt>Pessoas apoiadas</dt><dd class="stat-value">{String(supported)}</dd></div>
          <div class="stat"><dt>Marca da ponta</dt><dd class="stat-value stat-value--time">{shortHash(ledger.checkpoint.headHash)}</dd></div>
          <div class="stat"><dt>Última ação</dt><dd class="stat-value stat-value--time">{last ? <><time datetime={last.recordedAt}>{lastDay}</time> <span>{lastTime}</span></> : 'nenhuma'}</dd></div>
        </dl>
        <p class="stats-note"><Icon name="clock" /><span>{snapshot.status}. Aqui nunca vai ter número inventado.</span></p>
      </div>
    </div>

    <div class="panel ledger-now" id="livro-agora" aria-labelledby="t-now">
      <div class="panel-head">
        <h2 id="t-now">A corrente agora</h2>
        <p>Cada bloco é uma ação e aponta pro anterior. Mexeu em um, a corrente quebra. O livro é refeito a cada ação nova.</p>
        <a class="panel-link" href="/transparencia#corrente">Abrir a corrente inteira<Icon name="arrow-right" /></a>
      </div>
      <ChainStrip events={events} id="chain-home" label="As ações mais novas da corrente" head={7} link={seq => `/transparencia#acao-${seq}`} more="/transparencia#corrente" />
      <div class="ledger-now-foot">
        <div class="map-wrap">
          <p class="map-label"><span>nº 1</span><span>as {actions(events.length)}, da primeira à mais nova</span><span>nº {events.length}</span></p>
          <ChainMap events={events} id="map-home" />
        </div>
        <VerifyPanel data="ledger-home" marks="#chain-home, #map-home" />
      </div>
    </div>
  </div>
  <LedgerData id="ledger-home" ledger={ledger} />
</section>
