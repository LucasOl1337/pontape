---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import PrismArt from '../site/PrismArt.astro';
import { PRISM_TALL, PRISM_WIDE } from '../site/prism';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { PROJECT_NAME, formatDay } from '../../data/site/project';
import { SHARE } from '../../data/site/share';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
// F02 snapshot: validated at build, so the money shown here can only be the honest zero.
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const rays = [
  { module: 'M5', icon: 'plate', label: 'Comida' },
  { module: 'M5', icon: 'shirt', label: 'Roupa' },
  { module: 'M5', icon: 'soap', label: 'Higiene' },
  { module: 'M6', icon: 'briefcase', label: 'Trabalho' },
  { module: 'M7', icon: 'voice-ai', label: 'IA' },
] as const;
const stats = [
  { vt: 'stat-in', label: 'Entrou', value: brl.format(snapshot.receivedCents / 100), note: 'A doação ainda não abriu' },
  { vt: 'stat-out', label: 'Saiu', value: brl.format(snapshot.spentCents / 100), note: 'Nada foi gasto até hoje' },
  { vt: 'stat-people', label: 'Pessoas atendidas', value: '0', note: 'O atendimento ainda não começou' },
  { vt: 'stat-actions', label: 'Ações no livro', value: String(ledger.events.length), note: 'Cada uma dá pra conferir', live: true },
];
const speech = `Aqui é o ${PROJECT_NAME}. O primeiro passo pra quem quer mudar de vida. A gente encontra quem quer recomeçar. Garante comida, roupa e higiene nos primeiros dias. E ajuda a chegar num trabalho, com apoio de inteligência artificial. Tudo que a gente faz fica num livro público, e qualquer pessoa confere. É um projeto sem fins lucrativos, com código aberto.`;
---
<section class="hero" id="inicio" aria-labelledby="hero-title" data-speech={speech}>
  <div class="hero-bg" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span class="chip"><span class="chip-dot" aria-hidden="true"></span>Sem fins lucrativos</span>
        <span class="chip">Código aberto</span>
        <ListenButton target="inicio" />
      </div>
      <h1 id="hero-title">{SHARE.home.lead} <span class="grad">{SHARE.home.highlight}</span></h1>
      <p class="lead">A gente encontra quem quer recomeçar. Garante comida, roupa e higiene nos primeiros dias. E ajuda a chegar num trabalho, com apoio de inteligência artificial.</p>
      <div class="actions hero-actions">
        <a class="btn btn--primary" href="#como-funciona">Como funciona<Icon name="arrow-right" /></a>
        <a class="btn" href="/transparencia"><Icon name="eye" />Abrir o livro público</a>
      </div>
    </div>

    <figure class="prism" aria-labelledby="prism-caption">
      <div class="prism-stage">
        <PrismArt drawing={PRISM_WIDE} id="pw" class="prism-svg--wide" />
        <PrismArt drawing={PRISM_TALL} id="pt" class="prism-svg--tall" />
        <span class="prism-label prism-label--in" style={`--y:${PRISM_WIDE.beamLabel.y}%;--y-tall:${PRISM_TALL.beamLabel.y}%`}>Quem quer recomeçar</span>
        <span class="prism-label prism-label--glass" style={`--x:${PRISM_WIDE.glassLabel.x}%;--y:${PRISM_WIDE.glassLabel.y}%;--x-tall:${PRISM_TALL.glassLabel.x}%;--y-tall:${PRISM_TALL.glassLabel.y}%`}>{PROJECT_NAME}<small>tudo à vista</small></span>
      </div>
      <ol class="prism-rays" aria-label="Os cinco apoios que a gente oferece">
        {rays.map((r, i) => (
          <li data-ray={i + 1} style={`--i:${i}`}>
            <button class="ray-chip" type="button" data-module={r.module} aria-haspopup="dialog">
              <span class="ray-icon"><Icon name={r.icon} /></span><span class="ray-label">{r.label}</span><span class="module-id">{r.module}</span>
            </button>
          </li>
        ))}
      </ol>
      <figcaption id="prism-caption">O pontapé inicial: uma pessoa entra, cinco apoios saem, e tudo que passa pelo meio fica à vista. Toque num apoio pra ver como ele funciona.</figcaption>
    </figure>

    <div class="stats" role="group" aria-label="Números de hoje">
      {stats.map(s => (
        <div class="tile stat" style={`view-transition-name:${s.vt}`} data-vt={s.vt}>
          <span class="stat-label">{s.live && <span class="live-dot" aria-hidden="true"></span>}{s.label}</span>
          <span class="stat-value">{s.value}</span>
          <span class="stat-note">{s.note}</span>
        </div>
      ))}
      <p class="stats-note">
        <Icon name="clock" /><span>{snapshot.status}. Dados de <time datetime={snapshot.asOf}>{formatDay(snapshot.asOf)}</time>. Aqui nunca vai ter número inventado.</span>
        <a class="link-arrow" href="/transparencia">Abrir o livro<Icon name="arrow-right" /></a>
      </p>
    </div>
  </div>
</section>
