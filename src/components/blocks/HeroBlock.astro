---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import { PROJECT_NAME, formatDay } from '../../data/site/project';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
// F02 snapshot: validated at build, so the money shown here can only be the honest zero.
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const steps = [
  { module: 'M5', icon: 'plate', label: 'Comida' },
  { module: 'M5', icon: 'shirt', label: 'Roupa' },
  { module: 'M5', icon: 'soap', label: 'Higiene' },
  { module: 'M6', icon: 'briefcase', label: 'Trabalho' },
  { module: 'M7', icon: 'voice-ai', label: 'IA' },
] as const;
const speech = `Aqui é o ${PROJECT_NAME}. O primeiro passo pra quem quer mudar de vida. A gente encontra quem quer recomeçar. Garante comida, roupa e higiene nos primeiros dias. E ajuda a chegar num trabalho, com apoio de inteligência artificial. Tudo que a gente faz fica num livro público, e qualquer pessoa confere. É um projeto sem fins lucrativos, com código aberto.`;
---
<section class="hero" id="inicio" aria-labelledby="hero-title" data-speech={speech}>
  <div class="hero-inner">
    <div class="hero-grid">
      <div>
        <div class="kicker">
          <span class="chip">Sem fins lucrativos</span>
          <span class="chip">Código aberto</span>
          <ListenButton target="inicio" />
        </div>
        <h1 id="hero-title">O primeiro passo pra quem quer <span class="highlight">mudar de vida.</span></h1>
        <p class="lead">A gente encontra quem quer recomeçar. Garante comida, roupa e higiene nos primeiros dias. E ajuda a chegar num trabalho, com apoio de inteligência artificial.</p>
        <p class="promise"><Icon name="eye" /><span>Tudo que a gente faz fica num livro público. Qualquer pessoa confere.</span></p>
        <div class="actions">
          <a class="btn btn--primary" href="#como-funciona">Como funciona <Icon name="arrow-right" /></a>
          <a class="btn" href="/transparencia">Abrir o livro público</a>
        </div>
      </div>
      <figure class="hero-stairs stairs-box">
        <span class="sun" aria-hidden="true"></span>
        <ol class="stairs" aria-label="Os cinco degraus que a gente oferece">
          {steps.map((s, i) => (
            <li style={`--n:${i + 1}`}><button class="step" type="button" data-module={s.module} aria-haspopup="dialog"><Icon name={s.icon} />{s.label}</button></li>
          ))}
        </ol>
        <figcaption>Um degrau de cada vez. Toque num degrau pra ver como ele funciona.</figcaption>
      </figure>
    </div>

    <div class="scoreboard" role="group" aria-label="Números de hoje">
      <div class="scoreboard-item"><span class="scoreboard-label">Entrou</span><span class="scoreboard-value">{brl.format(snapshot.receivedCents / 100)}</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Saiu</span><span class="scoreboard-value">{brl.format(snapshot.spentCents / 100)}</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Pessoas atendidas</span><span class="scoreboard-value">0</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Ações no livro</span><span class="scoreboard-value">{ledger.events.length}</span></div>
      <p class="scoreboard-note">
        <span>{snapshot.status}. Dados de <time datetime={snapshot.asOf}>{formatDay(snapshot.asOf)}</time>.{ledger.events.length > 0 && ` O livro público já tem ${ledger.events.length} ações do projeto.`}</span>
        <a href="/transparencia">Abrir o livro</a>
      </p>
    </div>
  </div>
</section>
