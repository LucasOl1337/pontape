---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import Badge from '../site/Badge.astro';
import { STEPS } from '../../data/site/journey';
import { MODULES } from '../../data/site/modules';

const speech = `São ${STEPS.length} passos. ` + STEPS.map((s, i) => `${i + 1}: ${s.title}. ${s.text}`).join(' ');
const moduleOf = (id: string) => MODULES.find(m => m.id === id)!;
// Each step publishes a view timeline; the index beside the list lights the step being read (css only).
const timelines = STEPS.map((_, i) => `--passo-${i + 1}`).join(', ');
---
<section class="section section--band journey" id="como-funciona" aria-labelledby="t-how" data-speech={speech} style={`timeline-scope:${timelines}`}>
  <div class="wrap journey-grid">
    <div class="journey-intro">
      <div class="section-head reveal">
        <BlockHead number="03" label="Como funciona" listen="como-funciona" />
        <h2 id="t-how">Sete passos. Do primeiro encontro ao trabalho.</h2>
        <p class="lead">Desça a página e acompanhe o caminho. Cada passo diz quem faz o quê.</p>
      </div>
      <ol class="journey-index" aria-label="Os sete passos">
        {STEPS.map((s, i) => (
          <li style={`--tl:--passo-${i + 1}`}><a href={`#passo-${i + 1}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s.shortName}</a></li>
        ))}
      </ol>
    </div>
    <ol class="journey-list">
      {STEPS.map((s, i) => {
        const m = moduleOf(s.module);
        return (
          <li class="step" id={`passo-${i + 1}`} style={`view-timeline-name:--passo-${i + 1};--sc:var(--step-${i + 1})`}>
            <span class="step-node" aria-hidden="true">{i + 1}</span>
            <div class="tile step-card reveal">
              <div class="tile-kicker">
                <span class="glyph"><Icon name={s.icon} /></span>
                <span class="tile-label">Passo {i + 1} de {STEPS.length}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <p class="step-who"><span class="tile-label">Quem faz</span>{s.who.map(w => <span class="chip">{w}</span>)}</p>
              <button class="step-module" type="button" data-module={m.id} aria-haspopup="dialog">
                <span class="module-id">{m.id}</span><span class="step-module-name">{m.name}</span><Badge status={m.status} /><Icon name="arrow-right" class="arrow" />
              </button>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
