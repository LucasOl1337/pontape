---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import Badge from '../site/Badge.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import { STEPS } from '../../data/site/journey';
import { MODULES } from '../../data/site/modules';

// The journey as a pipeline. Each stage that has a ledger action shows its count from the real
// ledger, so the page says honestly how many people went through it (today: zero).
interface Props { events: LedgerEvent[] }
const { events } = Astro.props;
const moduleOf = (id: string) => MODULES.find(m => m.id === id)!;
const candidate = (action: string) => events.reduce((n, { payload: p }) => p.type === 'candidate' && p.action === action ? n + BigInt(p.count) : n, 0n);
const COUNTERS: Record<number, { value: string; label: string } | undefined> = {
  0: { value: String(candidate('contact_completed')), label: 'contatos feitos' },
  1: { value: String(candidate('interview_completed')), label: 'entrevistas concluídas' },
  3: { value: String(candidate('support_completed')), label: 'apoios dos primeiros dias' },
  4: { value: String(candidate('referral_completed')), label: 'encaminhamentos pra vaga' },
  6: { value: String(events.length), label: 'ações no livro' },
};
const speech = `São ${STEPS.length} passos. ` + STEPS.map((s, i) => `${i + 1}: ${s.title}. ${s.text}`).join(' ');
---
<section class="block" id="como-funciona" aria-labelledby="t-how" data-speech={speech}>
  <BlockHead number="05" label="Como funciona" listen="como-funciona" />
  <div class="block-intro">
    <h2 id="t-how">Sete passos. Do primeiro encontro ao trabalho.</h2>
    <p class="lead">Cada passo tem dono, módulo e contador no livro. O contador só mostra número: ninguém é exposto.</p>
  </div>
  <ol class="pipeline">
    {STEPS.map((s, i) => {
      const m = moduleOf(s.module);
      const c = COUNTERS[i];
      return (
        <li class="stage" data-status={m.status}>
          <span class="stage-node" aria-hidden="true"><Icon name={s.icon} /></span>
          <div class="stage-body">
            <p class="stage-num">Passo {i + 1} de {STEPS.length}</p>
            <h3>{s.title}</h3>
            <p class="stage-text">{s.text}</p>
            <p class="stage-who"><span class="sr-only">Quem faz: </span>{s.who.map(w => <span class="chip">{w}</span>)}</p>
          </div>
          <div class="stage-side">
            <a class="stage-module" href={`#${m.id.toLowerCase()}`}><span class="module-id">{m.id}</span><span>{m.name}</span></a>
            <Badge status={m.status} />
            {c
              ? <p class="stage-count"><span class="stage-count-value">{c.value}</span><span>{c.label}</span></p>
              : <p class="stage-count is-none"><span>Sem contador próprio</span></p>}
          </div>
        </li>
      );
    })}
  </ol>
</section>
