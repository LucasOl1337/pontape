---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import { TYPES, TYPE_ORDER } from '../../lib/ledger-view/phrases';

const RULES = {
  finance: ['Toda doação, todo gasto, tarifa e estorno, com valor e categoria. O comprovante aparece como pendente até dar pra publicar sem dado pessoal.', 'Quem doou, CPF, chave Pix, conta.'],
  field: ['Quantas entregas de comida, roupa e kit de higiene.', 'Quem recebeu, lugar.'],
  candidate: ['Só contagens: quantos contatos, entrevistas, encaminhamentos pra vaga e apoios dos primeiros dias.', 'Nome, rosto, apelido, lugar, história, o caminho de uma pessoa.'],
  project: ['Criação do repositório, decisões registradas, mudanças integradas no código. Com link pra fonte.', 'Texto solto, link qualquer, dado pessoal.'],
} as const;
const speech = 'O que entra no livro, e o que nunca entra. ' + TYPE_ORDER.map(t => `${TYPES[t].label}: entra ${RULES[t][0]} Nunca entra: ${RULES[t][1]}`).join(' ');
---
<section class="block" id="o-que-entra" aria-labelledby="t-types" data-speech={speech}>
  <BlockHead number="07" label="O que entra" listen="o-que-entra" />
  <div class="block-intro">
    <h2 id="t-types">O que entra no livro. E o que nunca entra.</h2>
    <p class="lead">O formato é fechado: não tem campo de texto livre, então não tem onde escrever o nome de ninguém.</p>
  </div>
  <div class="panel schema">
    <table>
      <caption class="sr-only">O que entra e o que nunca entra, por tipo de ação</caption>
      <thead><tr><th scope="col">Tipo</th><th scope="col">Entra</th><th scope="col">Nunca entra</th></tr></thead>
      <tbody>
        {TYPE_ORDER.map(t => (
          <tr data-type={t}>
            <th scope="row"><span class="type-tag" data-type={t}><Icon name={TYPES[t].icon} /></span>{TYPES[t].label}</th>
            <td>{RULES[t][0]}</td>
            <td class="never"><Icon name="x-circle" />{RULES[t][1]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
