---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import Badge from '../site/Badge.astro';
import ListenButton from '../site/ListenButton.astro';
import { DETAIL_FIELDS, MODULES } from '../../data/site/modules';
import { STATUSES, STATUS_ORDER } from '../../data/site/statuses';
import { STATUS_DATE, STATUS_DATE_SPOKEN, formatDay, withName } from '../../data/site/project';

// Modules as a status page: one bar with the share of each state, then one row per module.
const joinList = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} e ${items.at(-1)}`;
const byStatus = (s: string) => MODULES.filter(m => m.status === s);
const labelsForSpeech: Record<string, string> = {
  live: 'Funcionando', building: 'Em construção',
  bottleneck: 'Precisa de ajuda, que é o que a gente ainda não sabe resolver', planned: 'Planejados',
};
const speech = `O projeto tem ${MODULES.length} módulos. Estado em ${STATUS_DATE_SPOKEN}. ` + STATUS_ORDER.map(s => {
  const names = byStatus(s).map(m => m.name);
  return names.length ? `${labelsForSpeech[s]}: ${names.length}. ${joinList(names)}.` : `${labelsForSpeech[s]}: nenhum ainda.`;
}).join(' ') + ' Toque num módulo pra saber mais.';
const moduleLead = (m: (typeof MODULES)[number]) => `Módulo ${m.id.slice(1)}: ${m.name}. Estado: ${STATUSES[m.status].label}.`;
---
<section class="block" id="modulos" aria-labelledby="t-modules" data-speech={speech}>
  <BlockHead number="06" label="Módulos" listen="modulos" />
  <div class="block-intro">
    <h2 id="t-modules">Nove módulos. Cada um diz se já funciona.</h2>
    <p class="lead">O projeto é feito de partes separadas. Abra um módulo pra ver o que é, como funciona e o que falta.</p>
  </div>
  <div class="panel status-page">
    <div class="status-summary">
      <p class="status-date">Estado em <time datetime={STATUS_DATE}>{formatDay(STATUS_DATE)}</time></p>
      <div class="status-bar" aria-hidden="true">
        {STATUS_ORDER.filter(s => byStatus(s).length).map(s => <span data-status={s} style={`flex:${byStatus(s).length}`}></span>)}
      </div>
      <div class="filters" role="group" aria-label="Filtrar por estado" data-module-filters>
        <button class="filter" type="button" data-filter="all" aria-pressed="true">Todos<span class="count">{MODULES.length}</span></button>
        {STATUS_ORDER.map(s => (
          <button class="filter" type="button" data-filter={s} aria-pressed="false"><span class="status-dot" data-status={s} aria-hidden="true"></span>{STATUSES[s].label}<span class="count">{byStatus(s).length}</span></button>
        ))}
      </div>
      {STATUS_ORDER.map(s => <p class="filter-note" data-filter-note={s} hidden><Badge status={s} /><span>{STATUSES[s].meaning}</span></p>)}
    </div>
    <ul class="module-rows">
      {MODULES.map(m => (
        <li data-status-item={m.status}>
          <details class="module-row" id={m.id.toLowerCase()} data-status={m.status}>
            <summary>
              <span class="status-dot" data-status={m.status} aria-hidden="true"></span>
              <span class="module-id">{m.id}</span>
              <span class="module-main"><span class="module-name">{m.name}</span><span class="module-summary">{withName(m.summary)}</span></span>
              <Badge status={m.status} />
              <Icon name="chevron-down" class="chevron" />
            </summary>
            <div class="module-detail">
              <ListenButton target={`${m.id.toLowerCase()}-campos`} lead={moduleLead(m)} />
              <dl class="module-fields" id={`${m.id.toLowerCase()}-campos`}>
                {DETAIL_FIELDS.map(f => <div class={f.tone ? `is-${f.tone}` : undefined}><dt>{f.label}</dt><dd>{withName(m[f.key])}</dd></div>)}
              </dl>
            </div>
          </details>
        </li>
      ))}
    </ul>
    {STATUS_ORDER.filter(s => !byStatus(s).length).map(s => (
      <div class="module-empty" data-empty-for={s} hidden>
        {s === 'live'
          ? <><strong>Nenhum módulo funcionando ainda.</strong><p>É cedo: o projeto começou em setembro de 2026. Quando um módulo entrar no ar, o estado muda aqui, com a data.</p></>
          : <strong>Nenhum módulo nesse estado.</strong>}
      </div>
    ))}
  </div>
</section>
