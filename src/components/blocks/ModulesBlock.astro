---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import Badge from '../site/Badge.astro';
import ListenButton from '../site/ListenButton.astro';
import type { IconName } from '../site/icon-names';
import type { LedgerView } from '../../lib/ledger-view/source';
import { DETAIL_FIELDS, MODULES } from '../../data/site/modules';
import { STATUSES, STATUS_ORDER } from '../../data/site/statuses';
import { STATUS_DATE, STATUS_DATE_SPOKEN, formatDay, withName } from '../../data/site/project';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const joinList = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} e ${items.at(-1)}`;
const byStatus = (s: string) => MODULES.filter(m => m.status === s);
const labelsForSpeech: Record<string, string> = {
  live: 'Funcionando', building: 'Em construção',
  bottleneck: 'Precisa de ajuda, que é o que a gente ainda não sabe resolver', planned: 'Planejados',
};
const speech = `O projeto tem ${MODULES.length} blocos. Estado em ${STATUS_DATE_SPOKEN}. ` + STATUS_ORDER.map(s => {
  const names = byStatus(s).map(m => m.name);
  return names.length ? `${labelsForSpeech[s]}: ${names.length}. ${joinList(names)}.` : `${labelsForSpeech[s]}: nenhum ainda.`;
}).join(' ') + ' Toque num bloco pra saber mais.';
const moduleSpeech = (m: (typeof MODULES)[number]) =>
  `Bloco ${m.id.slice(1)}: ${m.name}. Estado: ${STATUSES[m.status].label}. ` + DETAIL_FIELDS.map(f => `${f.label}: ${withName(m[f.key])}`).join(' ');

// Bento layout of the nine blocks (4 columns on desktop): the ledger is the big one.
const LAYOUT: Record<string, { size: string; icon: IconName }> = {
  M1: { size: 'c2', icon: 'phone' },
  M2: { size: 'c2 r2', icon: 'shield' },
  M3: { size: '', icon: 'pin' },
  M4: { size: '', icon: 'mic' },
  M5: { size: '', icon: 'plate' },
  M6: { size: '', icon: 'briefcase' },
  M7: { size: 'c2', icon: 'voice-ai' },
  M8: { size: 'c2', icon: 'code' },
  M9: { size: 'c2', icon: 'pen' },
};
const shortHash = (h: string) => `${h.slice(0, 4)} ${h.slice(4, 8)}`;
const chain = ledger.events.slice(-3);
---
<section class="section" id="modulos" aria-labelledby="t-modules" data-speech={speech}>
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="04" label="Módulos" listen="modulos" />
      <h2 id="t-modules">Nove blocos. Cada um diz se já funciona.</h2>
      <p class="lead">O projeto é feito de partes separadas. Toque num bloco pra ver o que é, como funciona e o que falta.</p>
    </div>
    <div class="module-toolbar reveal">
      <div class="filters" role="group" aria-label="Filtrar por estado" data-module-filters>
        <button class="filter" type="button" data-filter="all" aria-pressed="true">Todos<span class="count">{MODULES.length}</span></button>
        {STATUS_ORDER.map(s => (
          <button class="filter" type="button" data-filter={s} aria-pressed="false"><Icon name={STATUSES[s].icon} />{STATUSES[s].label}<span class="count">{byStatus(s).length}</span></button>
        ))}
      </div>
      <p class="filter-note" data-filter-note="all"><span class="status-date">Estado em {formatDay(STATUS_DATE)}</span><span>Toque num selo pra entender o que ele quer dizer.</span></p>
      {STATUS_ORDER.map(s => <p class="filter-note" data-filter-note={s} hidden><Badge status={s} /><span>{STATUSES[s].meaning}</span></p>)}
    </div>
    <ul class="bento module-grid" data-module-grid>
      {MODULES.map(m => (
        <li class:list={['module-cell', LAYOUT[m.id]!.size]} data-status-item={m.status} style={`--vt:mod-${m.id.toLowerCase()}`}>
          <button class:list={['tile', 'tile--action', 'module-card', 'reveal', { 'module-card--feature': m.id === 'M2' }]} type="button" data-module={m.id} data-status={m.status} aria-haspopup="dialog">
            <span class="tile-kicker"><span class="module-id">{m.id}</span><Badge status={m.status} /></span>
            <span class="module-name">{m.name}</span>
            <span class="module-summary">{withName(m.summary)}</span>
            {m.id === 'M2' && chain.length > 0 && (
              <span class="mini-chain" aria-hidden="true">
                {chain.map((e, i) => <>{i > 0 && <span class="mini-link"></span>}<span class="mini-block"><span class="mono">nº {e.sequence}</span><span class="mono mini-hash">{shortHash(e.hash)}</span></span></>)}
              </span>
            )}
            {m.id === 'M4' && <span class="wave" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`}></span>)}</span>}
            <span class="module-more">Ver o bloco<Icon name="arrow-right" /></span>
            <span class="tile-art" aria-hidden="true"><Icon name={LAYOUT[m.id]!.icon} /></span>
          </button>
        </li>
      ))}
    </ul>
    {STATUS_ORDER.filter(s => !byStatus(s).length).map(s => (
      <div class="tile module-empty" data-empty-for={s} hidden>
        {s === 'live'
          ? <><strong>Nenhum bloco funcionando ainda.</strong><p>É cedo: o projeto começou em setembro de 2026. Quando um bloco entrar no ar, o selo muda aqui, com a data.</p></>
          : <strong>Nenhum bloco nesse estado.</strong>}
      </div>
    ))}
  </div>
</section>

<dialog class="dialog" id="module-dialog" aria-labelledby="module-dialog-title">
  <div class="dialog-head">
    <div><span class="module-id" id="module-dialog-id"></span><h2 id="module-dialog-title"></h2></div>
    <button class="close-btn" type="button" data-close aria-label="Fechar"><Icon name="close" /></button>
  </div>
  <div class="dialog-body" id="module-dialog-body"></div>
</dialog>

{MODULES.map((m, i) => {
  const prev = MODULES[(i + MODULES.length - 1) % MODULES.length]!;
  const next = MODULES[(i + 1) % MODULES.length]!;
  return (
    <template id={`module-${m.id}`} data-name={m.name}>
      <p class="dialog-status"><Badge status={m.status} /><span class="status-date">Estado em {formatDay(STATUS_DATE)}</span><ListenButton speech={moduleSpeech(m)} /></p>
      <dl class="module-details">
        {DETAIL_FIELDS.map(f => <div class={f.tone ? `is-${f.tone}` : undefined}><dt>{f.label}</dt><dd>{withName(m[f.key])}</dd></div>)}
      </dl>
      <div class="dialog-nav">
        <button class="btn btn--small" type="button" data-module={prev.id} aria-label={`Bloco anterior: ${prev.name}`}><Icon name="arrow-left" />{prev.id}</button>
        <button class="btn btn--small" type="button" data-module={next.id} aria-label={`Próximo bloco: ${next.name}`}>{next.id}<Icon name="arrow-right" /></button>
      </div>
    </template>
  );
})}
