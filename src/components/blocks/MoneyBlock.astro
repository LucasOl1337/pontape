---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import MoneyFlow from '../ledger/MoneyFlow.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import { formatCents, sumMoney } from '../../lib/ledger-view/money';

// Money, from the ledger sums. On the home page the block has its own switch between the real
// ledger and the fictional example; on /transparencia the page-wide switch drives it.
interface Props { real: LedgerEvent[]; example: LedgerEvent[]; number: string; ownSwitch?: boolean }
const { real, example, number, ownSwitch = false } = Astro.props;
const panels = [{ mode: 'real', events: real }, { mode: 'example', events: example }] as const;
---
<section class="block" id="dinheiro" aria-labelledby="t-money" data-money-block
  data-speech="Quanto entrou, quanto saiu e pra onde foi. Hoje entrou zero real e saiu zero real. A doação só abre quando existir uma conta oficial do projeto. Aqui nunca vai ter número inventado. Dá pra ver como fica com dinheiro num exemplo, com valores de mentira.">
  <BlockHead number={number} label="Dinheiro" listen="dinheiro" />
  <div class="block-intro">
    <h2 id="t-money">Quanto entrou, quanto saiu, pra onde foi.</h2>
    <p class="lead">Cada real vira uma ação no livro. Até o custo pra manter o projeto de pé aparece aqui.</p>
  </div>
  {ownSwitch && (
    <div class="segmented" role="group" aria-label="Qual dinheiro mostrar">
      <button type="button" data-mode-switch="real" aria-pressed="true">Livro de verdade</button>
      <button type="button" data-mode-switch="example" aria-pressed="false">Exemplo fictício</button>
    </div>
  )}
  {panels.map(({ mode, events }) => {
    const totals = sumMoney(events);
    return (
      <div class="money" data-mode-panel={mode} hidden={mode !== 'real'}>
        {mode === 'example' && <p class="sample-banner"><Icon name="alert" /><span><strong>Exemplo.</strong> Valores fictícios, só pra mostrar como fica. Nada disso aconteceu.</span></p>}
        <div class="money-grid">
          <dl class="money-totals">
            <div><dt>Entrou</dt><dd>{formatCents(totals.inCents)}</dd></div>
            <div><dt>Saiu</dt><dd>{formatCents(totals.outCents)}</dd></div>
            <div class="is-balance"><dt>Em caixa</dt><dd>{formatCents(totals.balanceCents)}</dd></div>
          </dl>
          <MoneyFlow events={events} mode={mode}
            caption={mode === 'real' && totals.inCents === 0n
              ? 'Tudo zerado, e é de verdade. As faixas se enchem quando o primeiro real entrar.'
              : 'A espessura de cada faixa é o valor. Em caixa é o que ainda não foi gasto.'} />
        </div>
        {mode === 'real' && totals.inCents === 0n && (
          <div class="why-zero">
            <h3>Por que está zerado?</h3>
            <p>A doação só abre quando existir uma conta oficial do projeto. Assim todo real tem dono, nota e prestação de contas. <a href="/#gargalo-receber-doacao-do-jeito-certo">Ver esse gargalo</a></p>
          </div>
        )}
      </div>
    );
  })}
</section>
