---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import ActionTable from '../ledger/ActionTable.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import type { LedgerView } from '../../lib/ledger-view/source';
import { TYPES, TYPE_ORDER, type LedgerType } from '../../lib/ledger-view/phrases';
import { REPOSITORY_OPEN } from '../../data/site/project';

interface Props { ledger: LedgerView; example: LedgerView }
const { ledger, example } = Astro.props;
const lists = [{ mode: 'real', view: ledger }, { mode: 'example', view: example }] as const;
const count = (events: LedgerEvent[], type: LedgerType) => events.filter(e => e.payload.type === type).length;
const EMPTY: Record<LedgerType, [string, string]> = {
  finance: ['Nenhum real entrou nem saiu ainda.', 'A doação abre quando existir a conta oficial do projeto. Quando abrir, cada real aparece aqui. Aqui nunca vai ter número inventado.'],
  field: ['Nenhuma entrega na rua ainda.', 'Isso começa com o piloto. Cada comida, kit ou roupa entregue vira uma linha, sem dizer quem recebeu nem onde.'],
  candidate: ['Nenhum passo de candidato ainda.', 'A entrevista por voz ainda não abriu. Quando abrir, aparece aqui só a contagem: quantos contatos, entrevistas e encaminhamentos. Sem nome, rosto, apelido nem lugar.'],
  project: ['Nenhuma ação do projeto ainda.', 'Cada decisão e cada mudança integrada no código entra aqui sozinha.'],
};
---
<section class="block" id="acoes" aria-labelledby="t-actions">
  <BlockHead number="03" label="Todas as ações" speech="Todas as ações do livro, da mais nova pra mais antiga. Cada linha mostra o número, o tipo, o que foi, o dia, o valor quando tem, e a marca. Toque no número pra abrir a ação na corrente." />
  <div class="block-intro">
    <h2 id="t-actions">Todas as ações, da mais nova pra mais antiga.</h2>
    <p class="lead">Número, tipo, o que foi, dia, valor quando tem e a marca. Toque no número pra abrir a ação.</p>
  </div>
  {lists.map(({ mode, view: { events } }) => (
    <div class="filters" role="group" aria-label="Filtrar por tipo de ação" data-type-filters={mode} data-mode-panel={mode} hidden={mode !== 'real'}>
      <button class="filter" type="button" data-type-filter="all" aria-pressed="true">Todas<span class="count">{events.length}</span></button>
      {TYPE_ORDER.map(t => <button class="filter" type="button" data-type-filter={t} aria-pressed="false"><span class="type-dot" data-type={t} aria-hidden="true"></span>{TYPES[t].label}<span class="count">{count(events, t)}</span></button>)}
    </div>
  ))}
  <p class="decision-note"><Icon name="doc" /><span>O título de cada decisão vem do <code>DECISOES.md</code> e fica fora da marca. O Conferir prova a linha, não o título.{!REPOSITORY_OPEN && ' Os links pra fonte levam ao repositório, que ainda está fechado.'}</span></p>
  <div class="sample-tools" data-mode-panel="example" hidden>
    <p class="sample-banner"><Icon name="alert" /><span><strong>Exemplo.</strong> Dados fictícios do contrato do livro, pra mostrar como ele fica com dinheiro, entregas e candidatos. Nada disso aconteceu.</span></p>
    <div class="tamper">
      <p>Teste a corrente: mude o valor de uma linha escondido, sem refazer a marca dela. Depois aperte Conferir lá em cima.</p>
      <button class="btn" type="button" data-tamper><Icon name="pen" />Mudar uma linha escondido</button>
      <button class="btn" type="button" data-untamper hidden><Icon name="undo" />Desfazer a mudança</button>
    </div>
  </div>
  {lists.map(({ mode, view: { events } }) => (
    <div class="ledger-list" data-mode-panel={mode} data-ledger-list={mode} hidden={mode !== 'real'}>
      {events.length > 0 && <ActionTable events={events} id={`table-${mode}`} caption={mode === 'real' ? 'Todas as ações do livro' : 'Todas as ações do exemplo fictício'} />}
      {!events.length && <div class="empty-note" data-empty-for="all"><Icon name="receipt" /><p><strong>O livro ainda não tem nenhuma ação.</strong></p></div>}
      {TYPE_ORDER.filter(t => events.length && !count(events, t)).map(t => (
        <div class="empty-note" data-empty-for={t} hidden><Icon name={TYPES[t].icon} /><p><strong>{EMPTY[t][0]}</strong> {EMPTY[t][1]}</p></div>
      ))}
    </div>
  ))}
</section>
