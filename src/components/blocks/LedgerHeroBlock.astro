---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import HashPrint from '../ledger/HashPrint.astro';
import type { LedgerView } from '../../lib/ledger-view/source';
import { TYPES, TYPE_ORDER } from '../../lib/ledger-view/phrases';
import { formatCents, sumMoney } from '../../lib/ledger-view/money';
import { recordedText } from '../../scripts/hashprint';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const { events, checkpoint } = ledger;
const money = sumMoney(events);
const last = events.at(-1);
const byType = TYPE_ORDER.map(type => ({ type, count: events.filter(e => e.payload.type === type).length }));
const speech = `Livro público. Tudo que o projeto faz, à vista. ${events.length ? `Hoje o livro tem ${events.length} ações.` : 'O livro ainda não tem nenhuma ação.'} Dinheiro: entrou zero real e saiu zero real, porque a doação ainda não abriu. Toda ação aparece. Quem é a pessoa, não. Aperte Conferir e o seu aparelho refaz a conta de cada linha.`;
---
<section class="page-hero" id="livro" aria-labelledby="page-title" data-speech={speech}>
  <div class="hero-inner">
    <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span aria-hidden="true">/</span><span aria-current="page">Livro público</span></nav>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="page-title">Livro público. <span class="h1-sub">Tudo que o projeto faz, à vista.</span></h1>
        <p class="lead">Cada ação entra aqui: dinheiro, entrega na rua, passo de candidato e decisão do projeto. Cada linha fica presa na anterior. Qualquer pessoa confere, sem pedir licença.</p>
        <p class="rule-strip"><Icon name="shield" /><strong>Toda ação aparece. Quem é a pessoa, não.</strong></p>
        <div class="actions">
          <a class="btn btn--primary" href="#conferir"><Icon name="shield" />Conferir o livro</a>
          <ListenButton target="livro" />
        </div>
      </div>
      <div class="panel checkpoint">
        <p class="checkpoint-head"><span>Marca de controle</span><code>{checkpoint.ledger}</code></p>
        <dl class="checkpoint-list">
          <div class="is-wide"><dt>Marca da ponta</dt><dd><HashPrint hash={checkpoint.headHash} class="hashprint--big" /><code class="hash-full">{checkpoint.headHash}</code></dd></div>
          <div><dt>Ponta da corrente</dt><dd>{last ? `ação nº ${last.sequence}` : 'nenhuma'}</dd></div>
          <div><dt>Registrada</dt><dd>{last ? recordedText(last.recordedAt) : 'nada ainda'}</dd></div>
          <div><dt>Formato</dt><dd>versão {checkpoint.schemaVersion}</dd></div>
        </dl>
        <div class="checkpoint-actions">
          <a class="btn btn--small" href="/livro/ledger.json" download="livro.json"><Icon name="download" />Livro inteiro</a>
          <a class="btn btn--small" href="/livro/checkpoint.json" download="marca-de-controle.json"><Icon name="download" />Marca de controle</a>
        </div>
      </div>
    </div>
    <dl class="stats stats--row" aria-label="O livro hoje">
      <div class="stat stat--wide">
        <dt>Ações no livro</dt><dd class="stat-value">{events.length}</dd>
        <dd class="type-counts">{byType.map(t => <span><span class="type-dot" data-type={t.type} aria-hidden="true"></span>{TYPES[t.type].label} {t.count}</span>)}</dd>
      </div>
      <div class="stat"><dt>Entrou</dt><dd class="stat-value">{formatCents(money.inCents)}</dd></div>
      <div class="stat"><dt>Saiu</dt><dd class="stat-value">{formatCents(money.outCents)}</dd></div>
      <div class="stat"><dt>Em caixa</dt><dd class="stat-value">{formatCents(money.balanceCents)}</dd></div>
    </dl>
    <p class="stats-note"><Icon name="clock" /><span>Livro estático, refeito a cada ação nova. {last ? `Última ação registrada em ${recordedText(last.recordedAt)}.` : 'Nenhuma ação registrada ainda.'} Nada aqui se chama ao vivo enquanto não for.</span></p>
  </div>
</section>
