---
import Icon from '../site/Icon.astro';
import ListenButton from '../site/ListenButton.astro';
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';
import type { LedgerView } from '../../lib/ledger-view/source';
import MaracatuArt from '../site/MaracatuArt.astro';

interface Props { ledger: LedgerView }
const { ledger } = Astro.props;
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: snapshot.currency });
const events = ledger.events;
const last = events.at(-1);
const shortHash = (h: string) => `${h.slice(0, 4)} ${h.slice(4, 8)}`;
const recorded = last && new Date(last.recordedAt);
const recordedText = recorded && `${recorded.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}, às ${recorded.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' })}`;
const speech = `Livro público. Tudo que o projeto faz, à vista. ${events.length ? `Hoje o livro tem ${events.length} ações.` : 'O livro oficial ainda não foi publicado.'} Dinheiro: entrou zero real e saiu zero real, porque a doação ainda não abriu. Toda ação aparece. Quem é a pessoa, não.`;
---
<section class="page-hero" id="livro" aria-labelledby="page-title" data-speech={speech}>
  <div class="page-hero-inner">
    <div class="page-hero-grid">
      <div>
        <div class="kicker">
          <span class="chip">Livro público</span>
          <span class="chip">Transparência total</span>
          <ListenButton target="livro" />
        </div>
        <h1 id="page-title">Tudo que o projeto faz, <span class="highlight">à vista.</span></h1>
        <p class="lead">Cada ação entra aqui: dinheiro, entrega na rua, passo de candidato e decisão do projeto. Cada linha fica presa na anterior. Qualquer pessoa confere, sem pedir licença.</p>
        <p class="rule-strip"><Icon name="shield" /><strong>Toda ação aparece. Quem é a pessoa, não.</strong></p>
      </div>
      <div class="ledger-illustration" aria-hidden="true">
        <MaracatuArt kind="book" class="book-art" />
        <MaracatuArt kind="flower" class="ledger-flower" />
        <p class="ledger-art-caption"><strong>Livro aberto.</strong>Confiança se constrói à vista.</p>
      </div>
    </div>
    <div class="scoreboard" role="group" aria-label="O livro hoje">
      <div class="scoreboard-item"><span class="scoreboard-label">Ações no livro</span><span class="scoreboard-value">{events.length}</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Entrou</span><span class="scoreboard-value">{brl.format(snapshot.receivedCents / 100)}</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Saiu</span><span class="scoreboard-value">{brl.format(snapshot.spentCents / 100)}</span></div>
      <div class="scoreboard-item"><span class="scoreboard-label">Marca mais recente</span><span class="scoreboard-value">{last ? shortHash(last.hash) : 'nenhuma'}</span></div>
      <p class="scoreboard-note"><Icon name="clock" /><span>{last
        ? `Livro estático. Última ação registrada em ${recordedText}. A página é refeita sempre que entra uma ação nova.`
        : 'O livro oficial ainda não foi publicado. Quando for, aparece aqui a hora da última ação registrada. Nada nesta página se chama ao vivo enquanto não for.'}</span></p>
    </div>
  </div>
</section>
