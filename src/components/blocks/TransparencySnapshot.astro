---
import snapshotData from '../../data/transparency.json';
import { transparencySnapshotSchema } from '../../lib/transparency';

// Validar no build evita publicar um JSON inválido mesmo sem executar os testes.
const snapshot = transparencySnapshotSchema.parse(snapshotData);
const currency = new Intl.NumberFormat('pt-BR', {
  style: 'currency', currency: snapshot.currency,
});
const referenceDate = new Intl.DateTimeFormat('pt-BR', { timeZone: 'UTC' })
  .format(new Date(`${snapshot.asOf}T00:00:00Z`));
---
<section aria-labelledby="transparencia">
  <h2 id="transparencia">Transparência</h2>
  <p>{snapshot.status}</p>
  <dl>
    <div><dt>Recebido</dt><dd>{currency.format(snapshot.receivedCents / 100)}</dd></div>
    <div><dt>Gasto</dt><dd>{currency.format(snapshot.spentCents / 100)}</dd></div>
  </dl>
  <p>Dados de <time datetime={snapshot.asOf}>{referenceDate}</time>. Atualização manual.</p>
</section>
<style>
  section {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-ink);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  dl { display: flex; flex-wrap: wrap; gap: var(--space-8); }
  dd { margin: 0; font-family: var(--font-mono); font-size: 1.5rem; }
</style>
