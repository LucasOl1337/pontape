---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import ChainStrip from '../ledger/ChainStrip.astro';
import LedgerData from '../ledger/LedgerData.astro';
import type { LedgerView } from '../../lib/ledger-view/source';
import { labelsOf } from '../ledger/labels';
import { REPOSITORY_OPEN } from '../../data/site/project';

// The navigable chain and the inspector. The inspector is drawn in the browser from the same JSON
// that Conferir checks, plus the build-time labels (phrase and decision title).
interface Props { ledger: LedgerView; example: LedgerView }
const { ledger, example } = Astro.props;
const lists = [{ mode: 'real', view: ledger }, { mode: 'example', view: example }] as const;
const labels = { real: labelsOf(ledger.events), example: labelsOf(example.events), repositoryOpen: REPOSITORY_OPEN };
---
<section class="block" id="corrente" aria-labelledby="t-chain"
  data-speech="A corrente. Cada bloco é uma ação, do mais novo pro mais antigo, e cada um aponta pro anterior pela marca dele. Toque num bloco pra abrir a ação: dá pra ver o texto exato que vira a marca e refazer a conta dessa linha.">
  <BlockHead number="02" label="Corrente" listen="corrente" />
  <div class="block-intro">
    <h2 id="t-chain">Navegue pela corrente.</h2>
    <p class="lead">Do mais novo pro mais antigo. A marca de cada bloco aparece de novo no bloco seguinte, como anterior. Toque num bloco pra abrir a ação. As setas do teclado andam pela corrente.</p>
  </div>
  {lists.map(({ mode, view }) => (
    <div data-mode-panel={mode} hidden={mode !== 'real'}>
      {view.events.length
        ? <ChainStrip events={view.events} id={`chain-${mode}`} label={mode === 'real' ? 'Corrente do livro, da ação mais nova pra mais antiga' : 'Corrente do exemplo fictício'} />
        : <div class="empty-note"><Icon name="receipt" /><p><strong>O livro ainda não tem nenhuma ação.</strong> Veja como ele funciona no exemplo.</p></div>}
      <LedgerData id={`ledger-${mode}`} ledger={view} />
    </div>
  ))}
  <article class="panel inspector" id="inspetor" aria-labelledby="inspector-title" data-inspector tabindex="-1">
    <header class="inspector-head">
      <div>
        <p class="inspector-kicker">Ação aberta</p>
        <h3 id="inspector-title" data-inspector-title>Escolha um bloco da corrente</h3>
      </div>
      <div class="inspector-nav">
        <button class="btn btn--small" type="button" data-inspector-step="-1"><Icon name="arrow-left" /><span>Anterior</span></button>
        <button class="btn btn--small" type="button" data-inspector-step="1"><span>Próxima</span><Icon name="arrow-right" /></button>
      </div>
    </header>
    <div class="inspector-body" data-inspector-body>
      <p class="muted">Toque num bloco da corrente ou no número de uma ação na tabela.</p>
    </div>
  </article>
  <script type="application/json" id="ledger-labels" set:html={JSON.stringify(labels).replaceAll('<', '\\u003c')} />
</section>
