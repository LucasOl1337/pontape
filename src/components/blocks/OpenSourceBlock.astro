---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import { CONTRIBUTIONS } from '../../data/site/contributions';

const goodFirst = CONTRIBUTIONS.filter(c => c.goodFirst).length;
const files = [
  { icon: 'doc', path: 'docs/PRD.md', what: 'O que é o projeto e pra onde vai' },
  { icon: 'doc', path: 'docs/DECISOES.md', what: 'Cada decisão, com data e quem decidiu' },
  { icon: 'shield', path: 'livro público', what: 'Toda ação, presa na anterior' },
  { icon: 'folder', path: 'docs/design/', what: 'Esta cara que você está vendo' },
] as const;
---
<!-- 09 · Código aberto -->
<section class="section section--band" id="codigo-aberto" aria-labelledby="t-open"
  data-speech="Tudo no projeto é aberto: o código, os documentos, cada decisão e o livro público. Qualquer pessoa pode propor uma melhoria. Um admin revisa antes de entrar. O repositório abre ao público quando o nome e a licença forem decididos.">
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="09" label="Código aberto" listen="codigo-aberto" />
      <h2 id="t-open">Aberto pra ver. Aberto pra ajudar.</h2>
      <p class="lead">O código, os documentos, cada decisão e o livro público ficam num lugar aberto. Qualquer pessoa pode propor uma melhoria. Um admin revisa antes de entrar.</p>
    </div>
    <div class="bento open-bento">
      <ol class="tile contribute-steps c2 reveal">
        <li><span class="num-badge">1</span><p><strong>Olhe</strong> o código e os documentos.</p></li>
        <li><span class="num-badge">2</span><p><strong>Escolha</strong> uma contribuição aberta ou proponha uma ideia.</p></li>
        <li><span class="num-badge">3</span><p><strong>Um admin revisa</strong> e aprova antes de entrar.</p></li>
      </ol>
      <div class="tile repo c2 r2 reveal">
        <div class="repo-bar">
          <span class="repo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="mono repo-name">Repositório do projeto</span>
          <span class="badge badge--building"><Icon name="lock" />Fechado por enquanto</span>
        </div>
        <ul class="repo-files">
          {files.map(f => <li><Icon name={f.icon} /><code>{f.path}</code><span>{f.what}</span></li>)}
        </ul>
        <dl class="repo-facts">
          <div><dt>Licença</dt><dd>A definir</dd></div>
          <div><dt>Quem aprova</dt><dd>Admins do projeto</dd></div>
          <div><dt>Abre quando</dt><dd>Nome e licença decididos</dd></div>
        </dl>
      </div>
      <div class="tile open-contrib c2 reveal">
        <p class="open-count"><span class="mono">{CONTRIBUTIONS.length}</span> contribuições abertas</p>
        <p>{goodFirst} boas pra quem está começando.</p>
        <a class="btn" href="#contribuicoes">Ver as contribuições<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>
