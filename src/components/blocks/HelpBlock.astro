---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import Badge from '../site/Badge.astro';
import type { IconName } from '../site/icon-names';

const ways: { icon: IconName; title: string; text: string; open: boolean; when: string; link?: { href: string; label: string } }[] = [
  { icon: 'coin', title: 'Doar', text: 'Seu dinheiro vira comida, roupa e higiene. E cada real aparece no livro público.', open: false, when: 'Abre quando a conta oficial do projeto existir.', link: { href: '#gargalo-receber-doacao-do-jeito-certo', label: 'Entender por quê' } },
  { icon: 'people', title: 'Ser voluntário', text: 'Vá até a pessoa com o aparelho da conversa. A gente treina você antes.', open: false, when: 'Abre com o piloto na primeira cidade.' },
  { icon: 'briefcase', title: 'Oferecer vaga', text: 'Dê a primeira chance pra alguém que chegou preparado e quer muito trabalhar.', open: false, when: 'Abre quando as primeiras pessoas forem escolhidas.' },
  { icon: 'code', title: 'Contribuir', text: 'Código, design, pesquisa, campo, direito. Tem espaço pra muita coisa.', open: true, when: 'As tarefas já estão listadas. Pegar uma abre junto com o repositório.', link: { href: '#contribuicoes', label: 'Ver as contribuições' } },
];
---
<!-- 08 · Como ajudar -->
<section class="section" id="ajudar" aria-labelledby="t-help"
  data-speech="Tem quatro jeitos de ajudar: doar, ser voluntário, oferecer uma vaga ou contribuir com o projeto. A doação, o voluntariado e as vagas ainda não abriram. As contribuições já estão listadas, e pegar uma abre junto com o repositório. A gente não guarda contato de ninguém por enquanto.">
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="08" label="Como ajudar" listen="ajudar" />
      <h2 id="t-help">Tem lugar pra você aqui.</h2>
      <p class="lead">Quatro jeitos de entrar. Cada um diz, sem enrolação, se já dá pra começar.</p>
    </div>
    <ul class="bento help-grid">
      {ways.map((w, i) => (
        <li class="tile help-card c2 reveal" style={`--hc:var(--s${[1, 3, 4, 5][i]})`}>
          <div class="tile-kicker">
            <span class="glyph glyph--lg"><Icon name={w.icon} /></span>
            {w.open ? <Badge status="building" /> : <span class="badge badge--planned"><Icon name="clock" />Ainda não abriu</span>}
          </div>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <div class="tile-foot">
            <p class="help-when">{w.when}</p>
            {w.link && <a class="link-arrow" href={w.link.href}>{w.link.label}<Icon name="arrow-right" /></a>}
          </div>
        </li>
      ))}
    </ul>
    <p class="data-note reveal"><Icon name="lock" /><span>A gente não guarda contato de ninguém por enquanto. Lista de aviso e formulário só quando existir um responsável legal pelos dados.</span></p>
  </div>
</section>
