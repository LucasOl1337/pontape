---
import BlockHead from '../site/BlockHead.astro';
import Abacus from '../ledger/Abacus.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import { TYPES, TYPE_ORDER } from '../../lib/ledger-view/phrases';

// Home: the real ledger only. /transparencia renders one abacus per mode (real and example).
interface Props { real: LedgerEvent[]; example?: LedgerEvent[]; number: string; link?: boolean }
const { real, example, number, link = false } = Astro.props;
const panels = [{ mode: 'real', events: real }, ...(example ? [{ mode: 'example', events: example }] : [])] as const;
const counts = TYPE_ORDER.map(t => `${TYPES[t].label}: ${real.filter(e => e.payload.type === t).length}`).join('. ');
---
<section class="block" id="linha-do-tempo" aria-labelledby="t-timeline"
  data-speech={`Linha do tempo. Cada conta é uma ação, na ordem em que entrou no livro. Tem uma vareta pra cada tipo de ação. ${counts}. Vareta vazia é o que ainda não começou.`}>
  <BlockHead number={number} label="Linha do tempo" listen="linha-do-tempo" />
  <div class="block-intro">
    <h2 id="t-timeline">Tudo que já aconteceu, conta por conta.</h2>
    <p class="lead">Um ábaco: uma vareta pra cada tipo de ação, uma conta pra cada ação. Vareta vazia é o que ainda não começou.</p>
  </div>
  {panels.map(({ mode, events }) => (
    <div class="panel abacus-panel" data-mode-panel={example ? mode : undefined} hidden={mode !== 'real'}>
      <Abacus events={events} id={`abacus-${mode}`} label={mode === 'real' ? 'Ações do livro, por tipo e por ordem' : 'Ações do exemplo fictício, por tipo e por ordem'}
        link={link ? seq => `/transparencia#acao-${seq}` : undefined} />
    </div>
  ))}
</section>
