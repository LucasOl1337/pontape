---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';

const problems = [
  { title: 'Falta o mínimo pro primeiro passo.', text: 'Comer por alguns dias, roupa limpa, um banho, um trabalho. Sem isso, não dá nem pra começar.' },
  { title: 'Ajuda solta não vira caminho.', text: 'Um prato de comida ajuda hoje. Sem o resto, amanhã tudo volta.' },
  { title: 'Quem doa não vê o dinheiro.', text: 'E sem ver pra onde ele vai, desconfia. Com razão.' },
];
const path = [
  { icon: 'plate', label: 'Comida' },
  { icon: 'shirt', label: 'Roupa' },
  { icon: 'soap', label: 'Higiene' },
  { icon: 'briefcase', label: 'Trabalho' },
  { icon: 'voice-ai', label: 'IA' },
] as const;
---
<!-- 02 · O problema -->
<section class="section" id="problema" aria-labelledby="t-problem"
  data-speech="Dinheiro sozinho não resolve. Primeiro: falta o mínimo pro primeiro passo. Comer, roupa limpa, um banho e um trabalho. Segundo: ajuda solta não vira caminho. Um prato de comida ajuda hoje. Sem o resto, amanhã tudo volta. Terceiro: quem doa não vê pra onde vai o dinheiro. E desconfia, com razão. A raiz é acertar a pessoa e dar um caminho inteiro. Do prato de comida até o primeiro salário.">
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="02" label="O problema" listen="problema" />
      <h2 id="t-problem">Dinheiro sozinho não resolve.</h2>
    </div>
    <div class="bento bento--3">
      {problems.map((p, i) => (
        <div class="tile problem reveal">
          <span class="num-badge" aria-hidden="true">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
      <div class="tile root c4 reveal">
        <div class="root-text">
          <p class="tile-label">A raiz</p>
          <p class="root-line">Acertar a pessoa e dar um <span class="grad">caminho inteiro.</span></p>
          <p>Achar quem quer mudar de vida de verdade. E andar junto, do prato de comida até o primeiro salário.</p>
        </div>
        <div class="compare">
          <div class="segmented" role="group" aria-label="Comparar">
            <button type="button" data-compare="loose" aria-pressed="true">Ajuda solta</button>
            <button type="button" data-compare="full" aria-pressed="false">Caminho inteiro</button>
          </div>
          <ol class="path" id="compare-path" data-mode="loose" aria-describedby="compare-caption">
            {path.map((s, i) => <li style={`--i:${i}`}><span class="path-node"><Icon name={s.icon} /></span><span class="path-label">{s.label}</span></li>)}
          </ol>
          <p class="compare-caption" id="compare-caption" aria-live="polite">Só o prato de comida. Ajuda hoje, mas amanhã tudo volta.</p>
        </div>
      </div>
    </div>
  </div>
</section>
