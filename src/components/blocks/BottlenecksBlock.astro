---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import NotOpenBadge from '../site/NotOpenBadge.astro';
import { BOTTLENECKS } from '../../data/site/bottlenecks';

const speech = 'Estes são os problemas que a gente ainda não sabe resolver. '
  + BOTTLENECKS.map((b, i) => `${i + 1}: ${b.title}.`).join(' ')
  + ' Se você entende de algum desses assuntos, sua ajuda vale muito.';
---
<section class="section" id="gargalos" aria-labelledby="t-bottlenecks" data-speech={speech}>
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="06" label="Gargalos" listen="gargalos" />
      <h2 id="t-bottlenecks">O que a gente ainda não sabe resolver.</h2>
      <p class="lead">Falar disso também é transparência. Se você entende de algum desses assuntos, sua ajuda vale muito.</p>
    </div>
    <div class="bento bento--3 bottlenecks">
      {BOTTLENECKS.map((b, i) => (
        <article class="tile bottleneck reveal" id={`gargalo-${b.id}`} aria-labelledby={`gargalo-t-${i + 1}`}>
          <div class="tile-kicker"><span class="num-badge" aria-hidden="true">{i + 1}</span><span class="badge badge--bottleneck">{b.modules}</span></div>
          <h3 id={`gargalo-t-${i + 1}`}>{b.title}</h3>
          <p class="bottleneck-why">{b.why}</p>
          <dl class="bottleneck-facts">
            <div><dt>O que já está andando</dt><dd>{b.progress}</dd></div>
            <div><dt>Quem pode ajudar</dt><dd>{b.helpers}</dd></div>
          </dl>
        </article>
      ))}
      <div class="tile bottleneck-cta reveal">
        <span class="glyph"><Icon name="bulb" /></span>
        <h3>Entende de algum desses assuntos?</h3>
        <p>Cada gargalo já tem tarefas concretas esperando alguém. Dar uma ideia abre junto com o repositório.</p>
        <div class="tile-foot"><NotOpenBadge /><a class="link-arrow" href="#contribuicoes">Ver as contribuições<Icon name="arrow-right" /></a></div>
      </div>
    </div>
  </div>
</section>
