---
import BlockHead from '../site/BlockHead.astro';
import VerifyPanel from '../ledger/VerifyPanel.astro';
---
<section class="section verify-section" id="conferir" aria-labelledby="t-verify"
  data-speech="Confira você mesmo. O botão refaz a conta de cada ação no seu aparelho. Se alguém tiver mudado ou apagado qualquer linha, aparece aqui. Nada é enviado pra gente.">
  <div class="wrap">
    <div class="tile verify-stage reveal">
      <div class="verify-copy">
        <BlockHead number="01" label="Conferir" listen="conferir" />
        <h2 id="t-verify">Confira você mesmo.</h2>
        <p class="lead">O botão refaz a conta de cada ação no seu aparelho. Se alguém tiver mudado ou apagado qualquer linha, aparece aqui.</p>
      </div>
      <VerifyPanel data="ledger-real" list="ledger-chain-real" where="Roda no seu aparelho. Nada é enviado pra gente.">
        <a href="#como-conferir">Como funciona</a>
      </VerifyPanel>
    </div>
  </div>
</section>
