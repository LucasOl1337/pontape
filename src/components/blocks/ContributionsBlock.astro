---
import Icon from '../site/Icon.astro';
import BlockHead from '../site/BlockHead.astro';
import NotOpenBadge from '../site/NotOpenBadge.astro';
import { CONTRIBUTIONS, CONTRIBUTION_TYPES, issueUrl } from '../../data/site/contributions';
import { bottleneckTitle } from '../../data/site/bottlenecks';
import { REPOSITORY_OPEN } from '../../data/site/project';

// "Todas" shows the first HOME_LIMIT; the rest open with one button.
const HOME_LIMIT = 6;
const goodFirst = CONTRIBUTIONS.filter(c => c.goodFirst);
const joinList = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} e ${items.at(-1)}`;
const types = (Object.keys(CONTRIBUTION_TYPES) as (keyof typeof CONTRIBUTION_TYPES)[])
  .map(t => ({ id: t, ...CONTRIBUTION_TYPES[t], count: CONTRIBUTIONS.filter(c => c.type === t).length }))
  .filter(t => t.count > 0);
const speech = `Tem ${CONTRIBUTIONS.length} tarefas abertas. ${goodFirst.length} são boas pra quem está começando: ${joinList(goodFirst.map(c => c.title))}. Pegar uma tarefa abre junto com o repositório.`;
---
<section class="section section--band" id="contribuicoes" aria-labelledby="t-contrib" data-speech={speech}>
  <div class="wrap">
    <div class="section-head reveal">
      <BlockHead number="07" label="Contribuições abertas" listen="contribuicoes" />
      <h2 id="t-contrib">Onde você pode ajudar agora.</h2>
      <p class="lead">Tarefas concretas. Cada uma diz o tipo, se é um bom primeiro passo e qual gargalo ela destrava.</p>
    </div>
    <div class="filters contrib-filters reveal" role="group" aria-label="Filtrar contribuições" data-contrib-filters>
      <button class="filter" type="button" data-contrib="all" aria-pressed="true">Todas<span class="count">{CONTRIBUTIONS.length}</span></button>
      <button class="filter" type="button" data-contrib="first" aria-pressed="false"><Icon name="sprout" />Bom primeiro passo<span class="count">{goodFirst.length}</span></button>
      {types.map(t => <button class="filter" type="button" data-contrib={t.id} aria-pressed="false"><Icon name={t.icon} />{t.label}<span class="count">{t.count}</span></button>)}
    </div>
    <ul class="bento bento--3 contrib-grid" data-contrib-grid>
      {CONTRIBUTIONS.map((c, i) => {
        const unlocks = bottleneckTitle(c.bottleneck);
        return (
          <li class="tile contrib-card" data-type={c.type} data-first={String(c.goodFirst)} data-extra={i >= HOME_LIMIT ? 'true' : undefined} hidden={i >= HOME_LIMIT} style={`--vt:contrib-${c.id}`}>
            <div class="tile-kicker">
              <span class="chip"><Icon name={CONTRIBUTION_TYPES[c.type].icon} />{CONTRIBUTION_TYPES[c.type].label}</span>
              {c.goodFirst && <span class="chip chip--first"><Icon name="sprout" />Bom primeiro passo</span>}
            </div>
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <div class="tile-foot contrib-foot">
              <p class="contrib-unlocks"><span class="module-id">{c.module}</span>
                {unlocks ? <span>Destrava: <a href={`#gargalo-${c.bottleneck}`}>{unlocks}</a></span> : <span>Melhora a plataforma</span>}
              </p>
              <p class="contrib-status"><a class="link-arrow" href={issueUrl(c.issueNumber)} rel="noopener">Issue #{c.issueNumber}<Icon name="arrow-up-right" /></a>{!REPOSITORY_OPEN && <span>Repositório ainda fechado</span>}</p>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="contrib-toolbar"><button class="btn" type="button" data-contrib-more>Mostrar as {CONTRIBUTIONS.length} contribuições<Icon name="chevron-down" /></button></div>
    <p class="soon-note"><NotOpenBadge /><span>Cada tarefa já é uma issue no GitHub. Pegar uma abre junto com o repositório.</span></p>
  </div>
</section>
