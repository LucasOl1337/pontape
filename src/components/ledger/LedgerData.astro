---
import type { LedgerView } from '../../lib/ledger-view/source';

// Hands the published events and checkpoint to the browser as inert JSON (allowed by the CSP),
// so Conferir checks exactly what the page shows.
interface Props { id: string; ledger: LedgerView }
const { id, ledger } = Astro.props;
---
<script type="application/json" id={id} set:html={JSON.stringify(ledger).replaceAll('<', '\\u003c')} />
