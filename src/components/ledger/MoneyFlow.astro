---
import Icon from '../site/Icon.astro';
import type { LedgerEvent } from '../../lib/ledger/schema';
import { OUT_CATEGORIES } from '../../lib/ledger-view/phrases';
import { formatCents, sumMoney } from '../../lib/ledger-view/money';
import type { IconName } from '../site/icon-names';

// Money flow (Sankey): everything that came in, split into where it went and what stays in the
// till. Each destination gets a fixed slot so labels never collide; the band's thickness is the value.
// Built at build time from the ledger sums (BigInt), so the picture is exactly the ledger.
interface Props { events: LedgerEvent[]; mode: 'real' | 'example'; caption?: string }
const { events, mode, caption } = Astro.props;
const totals = sumMoney(events);
const balance = totals.balanceCents > 0n ? totals.balanceCents : 0n;
type Row = { id: string; name: string; icon: IconName; value: bigint };
const rows: Row[] = [
  ...OUT_CATEGORIES.map(c => ({ id: c.id, name: c.name, icon: c.icon, value: totals.outByCategory[c.id] ?? 0n })),
  { id: 'balance', name: 'Em caixa', icon: 'coin' as IconName, value: balance },
];
const scaleCents = totals.inCents > totals.outCents ? totals.inCents : totals.outCents;
const empty = scaleCents <= 0n;

const SLOT = 48;
const EXTRA = 14; // air before "Em caixa": it is what stays, not an expense
const H = rows.length * SLOT + EXTRA;
const MAX_BAR = H - 48;
const px = (cents: bigint) => empty ? 0 : (Number(cents) / Number(scaleCents)) * MAX_BAR;
const W = 100; // viewBox width; the SVG stretches sideways, the bars and labels stay in px

let cursor = (H - px(scaleCents)) / 2;
const flows = rows.map((r, i) => {
  const center = i * SLOT + SLOT / 2 + (r.id === 'balance' ? EXTRA : 0);
  const h = r.value > 0n ? Math.max(px(r.value), 2) : 0;
  const sy0 = cursor;
  cursor += px(r.value);
  const ty0 = center - h / 2;
  const share = empty ? 0 : Math.round((Number(r.value) / Number(scaleCents)) * 1000) / 10;
  return { ...r, center, h, ty0, sy0, sy1: sy0 + px(r.value), share };
});
const n = (v: number) => v.toFixed(1);
const path = (f: (typeof flows)[number]) => empty || f.value <= 0n
  ? `M0 ${n(H / 2)}C${W / 2} ${n(H / 2)} ${W / 2} ${n(f.center)} ${W} ${n(f.center)}`
  : `M0 ${n(f.sy0)}C${W / 2} ${n(f.sy0)} ${W / 2} ${n(f.ty0)} ${W} ${n(f.ty0)}V${n(f.ty0 + f.h)}C${W / 2} ${n(f.ty0 + f.h)} ${W / 2} ${n(f.sy1)} 0 ${n(f.sy1)}Z`;
const srcTop = empty ? H / 2 - 1 : (H - px(scaleCents)) / 2;
const srcH = empty ? 2 : px(scaleCents);
---
<figure class:list={['flow', { 'flow--empty': empty }]} data-flow={mode}>
  <div class="flow-grid" style={`--h:${H}px`}>
    <div class="flow-source" style={`--y:${H / 2}px`}>
      <span class="flow-label">Entrou</span>
      <span class="flow-value">{formatCents(totals.inCents)}</span>
      <span class="flow-note">em doações</span>
    </div>
    <div class="flow-canvas" aria-hidden="true">
      <span class="flow-bar flow-bar--source" style={`top:${n(srcTop)}px;height:${n(srcH)}px`}></span>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
        {flows.map(f => <path class:list={['flow-band', { 'is-zero': empty || f.value <= 0n }]} data-cat={f.id} d={path(f)} vector-effect="non-scaling-stroke" />)}
      </svg>
      {flows.map(f => <span class:list={['flow-bar', { 'is-zero': f.value <= 0n }]} data-cat={f.id} style={`top:${n(f.value > 0n ? f.ty0 : f.center - 8)}px;height:${n(f.value > 0n ? f.h : 16)}px`}></span>)}
    </div>
    <ul class="flow-targets" aria-hidden="true">
      {flows.map(f => (
        <li data-cat={f.id} style={`--y:${f.center}px`}>
          <span class="flow-target-name"><Icon name={f.icon} />{f.name}</span>
          <span class="flow-target-value">{formatCents(f.value)}<small>{f.share.toLocaleString('pt-BR')}%</small></span>
        </li>
      ))}
    </ul>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  <details class="flow-table">
    <summary>Ver os números em tabela</summary>
    <table>
      <caption class="sr-only">Pra onde foi o dinheiro{mode === 'example' ? ', no exemplo fictício' : ''}</caption>
      <thead><tr><th scope="col">Destino</th><th scope="col">Valor</th>{!empty && <th scope="col">Parte do que entrou</th>}</tr></thead>
      <tbody>
        <tr><th scope="row">Entrou em doações</th><td>{formatCents(totals.inCents)}</td>{!empty && <td>100%</td>}</tr>
        {flows.map(f => <tr><th scope="row">{f.name}</th><td>{formatCents(f.value)}</td>{!empty && <td>{f.share.toLocaleString('pt-BR')}%</td>}</tr>)}
      </tbody>
    </table>
  </details>
</figure>
