---
import Icon from '../site/Icon.astro';

// `data` is the id of the <script type="application/json"> holding the events to check (the home
// fetches the published file instead).
// `marks` lists the containers whose [data-seq] items light up as the check walks the chain.
// `log` adds the console that prints one line per action.
interface Props { data?: string; marks: string; where?: string; log?: boolean; label?: string }
const { data, marks, where = 'Refaz a conta de cada ação no seu aparelho. Nada é enviado pra gente.', log = false, label = 'Conferir' } = Astro.props;
---
<div class="verify" data-verify-panel data-source={data} data-marks={marks}>
  <div class="verify-bar">
    <button class="btn btn--primary" type="button" data-verify><Icon name="shield" />{label}</button>
    <p class="verify-where">{where} <slot /></p>
  </div>
  <div class="verify-progress" hidden><span></span></div>
  {log && <ol class="verify-log" aria-hidden="true" hidden></ol>}
  <div class="verify-result" role="status" aria-live="polite" data-state="idle">
    <Icon name="shield" />
    <div><p class="verify-title">Ainda não conferido.</p><p>Aperte Conferir e o seu aparelho refaz as contas de cada ação.</p></div>
  </div>
</div>
