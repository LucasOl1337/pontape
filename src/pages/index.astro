---
import BaseLayout from '../layouts/BaseLayout.astro';
import Escada from '../components/cronica/Escada.astro';
import Pecas from '../components/cronica/Pecas.astro';
import Gargalos from '../components/cronica/Gargalos.astro';
import Classificados from '../components/cronica/Classificados.astro';
import Expediente from '../components/cronica/Expediente.astro';
import Construir from '../components/cronica/Construir.astro';
import { getPublicLedger } from '../lib/ledger-view/source';
import { SHARE } from '../data/site/share';

const ledger = await getPublicLedger();
---
<BaseLayout
  title={SHARE.home.title}
  description={SHARE.home.description}
  share="home">
  <div class="front">
    <Escada ledger={ledger} />
  </div>
  <Construir />
  <Pecas />
  <Gargalos />
  <Classificados />
  <Expediente />
</BaseLayout>
<script>import '../scripts/home';</script>
