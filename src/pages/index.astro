---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capa from '../components/cronica/Capa.astro';
import ParaVoce from '../components/cronica/ParaVoce.astro';
import Problema from '../components/cronica/Problema.astro';
import Caminho from '../components/cronica/Caminho.astro';
import Pecas from '../components/cronica/Pecas.astro';
import Livro from '../components/cronica/Livro.astro';
import Gargalos from '../components/cronica/Gargalos.astro';
import Classificados from '../components/cronica/Classificados.astro';
import Ajudar from '../components/cronica/Ajudar.astro';
import Expediente from '../components/cronica/Expediente.astro';
import Fim from '../components/cronica/Fim.astro';
import { getPublicLedger } from '../lib/ledger-view/source';
import { SHARE } from '../data/site/share';

const ledger = await getPublicLedger();
---
<BaseLayout
  title={SHARE.home.title}
  description={SHARE.home.description}
  share="home">
  <Capa ledger={ledger} />
  <ParaVoce />
  <Problema />
  <Caminho />
  <Pecas />
  <Livro ledger={ledger} />
  <Gargalos />
  <Classificados />
  <Ajudar />
  <Expediente />
  <Fim />
</BaseLayout>
<script>import '../scripts/home';</script>
