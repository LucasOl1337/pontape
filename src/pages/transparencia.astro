---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivroCapa from '../components/cronica/LivroCapa.astro';
import Registro from '../components/cronica/Registro.astro';
import Dinheiro from '../components/cronica/Dinheiro.astro';
import ComoConferir from '../components/cronica/ComoConferir.astro';
import Regras from '../components/cronica/Regras.astro';
import { getExampleLedger, getPublicLedger } from '../lib/ledger-view/source';
import { SHARE } from '../data/site/share';

const ledger = await getPublicLedger();
const example = await getExampleLedger();
---
<BaseLayout
  title={SHARE.transparencia.title}
  description={SHARE.transparencia.description}
  share="transparencia"
  current="transparencia">
  <LivroCapa ledger={ledger} />
  <Registro ledger={ledger} example={example} />
  <Dinheiro real={ledger.events} example={example.events} />
  <ComoConferir ledger={ledger} />
  <Regras />
</BaseLayout>
<script>import '../scripts/ledger';</script>
