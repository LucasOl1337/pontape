---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Caderno from '../../components/cronica/Caderno.astro';
import Icon from '../../components/site/Icon.astro';
import { PROJECT_NAME } from '../../data/site/project';
import { REPO_URL } from '../../data/site/contributions';
import { serviceTrail } from '../../data/site/nav';
import { ALIMENTA } from '../../data/alimenta/rede';
import metrics from '../../../alimenta/model/artifacts/metrics.json';
import security from '../../../alimenta/seguranca/resumo.json';
import painel from '../../data/alimenta/painel.json';
import '../../styles/alimenta.css';
import { execFileSync } from 'node:child_process';

// Painel da Rede Alimenta (FIAP, página 10 do enunciado). Three kinds of number, never mixed:
// REAL (live from /kpis: honest zero until the first real donation), MODELO (metrics.json of the
// versioned model, measured on the held-out test) and SIMULADO (painel.json, built from the simulated
// dataset by alimenta/scripts/painel.py). Security comes from the real scans (resumo.json).
const fmt = new Intl.NumberFormat('pt-BR');
const pct = (x: number) => `${(x * 100).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
const t = metrics.test;
const [[tn, fp], [fn, tp]] = t.confusion_matrix.rows_true_cols_pred as [[number, number], [number, number]];
const base = metrics.baselines;
const compare = [
  { label: `Modelo ${metrics.model_version}`, acc: t.accuracy, main: true },
  { label: 'Regressão logística', acc: base.logistic_regression.accuracy },
  { label: 'Regra só de prazo', acc: base.deadline_rule.accuracy },
  { label: 'Chute: "não descarta"', acc: base.majority_class.accuracy },
];
const maxRegion = Math.max(...painel.regions.map(r => r.discard_rate));
const minRegion = Math.min(...painel.regions.map(r => r.discard_rate));
const heat = (rate: number) => (rate - minRegion) / Math.max(maxRegion - minRegion, 1e-9);
// Schematic map of São Paulo: the five regions in their compass place (north on top, west on the
// left), equal tiles, colour = discard rate. Kg per region is almost the same, so size would say nothing.
const PLACE: Record<string, [number, number]> = { north: [150, 10], west: [20, 95], center: [150, 95], east: [280, 95], south: [150, 180] };
const heatFill = (h: number) => `hsl(${Math.round(42 - 38 * h)} 85% ${Math.round(80 - 40 * h)}%)`;
const heatInk = (h: number) => (h > 0.55 ? '#FFFFFF' : '#18191D');
const tools = Object.entries(security.tools) as [string, { baseline: number; current: number; mitigated_ids: string[]; new_ids: string[] }][];
let commit = '';
try { commit = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(); } catch { /* build fora do git */ }
const workflow = `${REPO_URL}/actions/workflows/alimenta.yml`;
const risk = { high: 'alto', medium: 'médio', low: 'baixo' } as Record<string, string>;
---
<BaseLayout title={`Painel · ${ALIMENTA.name} · ${PROJECT_NAME}`}
  description="Os números da Rede Alimenta: doações reais, a precisão do modelo de AI, a segurança do código e um cenário simulado, cada um com o rótulo do que é."
  current="alimenta">
  <Caderno trail={serviceTrail('Painel', Astro.site)} title="Painel da" turn="Rede Alimenta."
    lead="Três tipos de número, sempre separados. Real: doação de verdade, ao vivo. Modelo: medido num teste que o modelo nunca viu. Simulado: dado inventado pra mostrar o sistema funcionando.">

    <ul class="pn-legend" aria-label="Legenda">
      <li><span class="pn-tag pn-tag--real">Real</span> vem do banco, ao vivo. Zero até a primeira doação de verdade.</li>
      <li><span class="pn-tag pn-tag--model">Modelo</span> medido no teste separado, com versão e amostra.</li>
      <li><span class="pn-tag pn-tag--sim">Simulado</span> dado inventado, marcado. Não é impacto real.</li>
    </ul>

    <section class="pn-block" aria-labelledby="pn-real-title">
      <h2 id="pn-real-title" class="kicker">Impacto real <span class="pn-tag pn-tag--real">Real</span></h2>
      <div class="pn-kpis" id="pn-live" aria-live="polite">
        <div class="pn-kpi"><strong data-k="kg_delivered">…</strong><span>kg entregues</span></div>
        <div class="pn-kpi"><strong data-k="meals_estimated">…</strong><span>refeições estimadas</span></div>
        <div class="pn-kpi"><strong data-k="donations">…</strong><span>doações registradas</span></div>
        <div class="pn-kpi"><strong data-k="match">…</strong><span>tempo médio até o destino</span></div>
      </div>
      <p class="pn-note" id="pn-live-note">Buscando os números no servidor da Rede Alimenta. Ele pode levar até um minuto pra acordar.</p>
      <p class="pn-note">Refeições estimadas: kg entregues ÷ {String(painel.kg_per_meal).replace('.', ',')} kg por refeição (<a href="https://www.feedingamerica.org/ways-to-give/faq/about-our-claims" rel="noopener">Feeding America</a>). Tempo até o destino: do registro da doação até a escolha de quem recebe. Contas de teste ficam fora. <a href="/api/alimenta/kpis">Ver os dados crus</a></p>
      <div id="pn-cities" hidden>
        <h3 class="pn-sub">Entregas por cidade do distribuidor</h3>
        <ol class="pn-bars" id="pn-cities-list"></ol>
      </div>
    </section>

    <section class="pn-block" aria-labelledby="pn-ai-title">
      <h2 id="pn-ai-title" class="kicker">Qualidade da AI <span class="pn-tag pn-tag--model">Modelo</span></h2>
      <p class="pn-lead">O modelo <span class="mono">{metrics.model_version}</span> ({metrics.algorithm}) estima a chance de um lote de comida ser descartado. Treinado em {fmt.format(metrics.split.n_train)} lotes simulados e testado em outros {fmt.format(metrics.split.n_test)} que ele nunca viu.</p>
      <div class="pn-kpis">
        <div class="pn-kpi"><strong>{pct(t.accuracy)}</strong><span>acurácia no teste</span></div>
        <div class="pn-kpi"><strong>{t.roc_auc.toLocaleString('pt-BR')}</strong><span>ROC AUC</span></div>
        <div class="pn-kpi"><strong>{pct(t.per_class.discarded.recall)}</strong><span>dos descartes reais o modelo pegou</span></div>
        <div class="pn-kpi"><strong>{pct(t.per_class.discarded.precision)}</strong><span>dos alertas eram descarte de fato</span></div>
      </div>
      <div class="pn-two">
        <div>
          <h3 class="pn-sub">Acurácia comparada</h3>
          <ol class="pn-bars">
            {compare.map(c => (
              <li class={c.main ? 'is-main' : ''}><span class="pn-bar-label">{c.label}</span>
                <span class="pn-bar"><span style={`width:${(c.acc * 100).toFixed(1)}%`}></span></span><span class="pn-bar-value">{pct(c.acc)}</span></li>
            ))}
          </ol>
          <p class="pn-note">O modelo ganha das três comparações no mesmo teste. Acurácia sozinha engana, por isso a matriz ao lado.</p>
        </div>
        <div>
          <h3 class="pn-sub">Matriz de confusão ({fmt.format(metrics.split.n_test)} lotes de teste)</h3>
          <table class="pn-matrix">
            <thead><tr><th scope="col"><span class="sr-only">Real × previsto</span></th><th scope="col">Previsto: aproveitado</th><th scope="col">Previsto: descartado</th></tr></thead>
            <tbody>
              <tr><th scope="row">Real: aproveitado</th><td class="ok">{fmt.format(tn)}</td><td>{fmt.format(fp)}</td></tr>
              <tr><th scope="row">Real: descartado</th><td>{fmt.format(fn)}</td><td class="ok">{fmt.format(tp)}</td></tr>
            </tbody>
          </table>
          <p class="pn-note">Rótulo e dados simulados por um processo escondido com ruído, não por uma regra de prazo (<a href={`${REPO_URL}/blob/main/alimenta/data/DICIONARIO.md`} rel="noopener">dicionário</a>). O CI retreina e confere estes números a cada commit.</p>
        </div>
      </div>
    </section>

    <section class="pn-block" aria-labelledby="pn-sim-title">
      <h2 id="pn-sim-title" class="kicker">Cenário de São Paulo <span class="pn-tag pn-tag--sim">Simulado</span></h2>
      <p class="pn-lead">{fmt.format(painel.totals.lots)} lotes simulados, {fmt.format(Math.round(painel.totals.kg))} kg. No histórico simulado, {pct(painel.totals.discard_rate)} foram descartados. O que não foi daria cerca de {fmt.format(painel.totals.meals_estimated)} refeições (estimativa).</p>
      <div class="pn-two">
        <figure class="pn-map">
          <svg viewBox="0 0 400 300" role="img" aria-labelledby="pn-map-cap">
            {painel.regions.map(r => {
              const h = heat(r.discard_rate); const [x, y] = PLACE[r.id] ?? [0, 0];
              return <g>
                <rect x={x} y={y} width="100" height="76" rx="4" fill={heatFill(h)} stroke="#18191D" stroke-width="2" />
                <text x={x + 50} y={y + 32} text-anchor="middle" class="pn-map-name" fill={heatInk(h)}>{r.label}</text>
                <text x={x + 50} y={y + 56} text-anchor="middle" class="pn-map-val" fill={heatInk(h)}>{pct(r.discard_rate)}</text>
              </g>;
            })}
            <defs><linearGradient id="pn-heat"><stop offset="0" stop-color={heatFill(0)} /><stop offset="1" stop-color={heatFill(1)} /></linearGradient></defs>
            <rect x="20" y="272" width="120" height="12" fill="url(#pn-heat)" stroke="#18191D" />
            <text x="20" y="298" class="pn-map-scale">{pct(minRegion)}</text>
            <text x="140" y="298" text-anchor="end" class="pn-map-scale">{pct(maxRegion)}</text>
          </svg>
          <figcaption id="pn-map-cap">Mapa de calor do descarte por região de São Paulo (simulado), na posição de cada região: norte em cima, oeste à esquerda. Mais vermelho, mais comida jogada fora. A Oeste é onde a Rede Alimenta mais faria diferença.</figcaption>
        </figure>
        <div>
          <h3 class="pn-sub">Refeições estimadas por região</h3>
          <ol class="pn-bars">
            {[...painel.regions].sort((a, b) => b.meals_estimated - a.meals_estimated).map(r => (
              <li><span class="pn-bar-label">{r.label}</span><span class="pn-bar"><span style={`width:${(100 * r.meals_estimated / Math.max(...painel.regions.map(x => x.meals_estimated))).toFixed(1)}%`}></span></span><span class="pn-bar-value">{fmt.format(r.meals_estimated)}</span></li>
            ))}
          </ol>
          <h3 class="pn-sub">Descarte por tipo de comida</h3>
          <ol class="pn-bars">
            {[...painel.categories].sort((a, b) => b.discard_rate - a.discard_rate).map(c => (
              <li><span class="pn-bar-label">{c.label}</span><span class="pn-bar pn-bar--warn"><span style={`width:${(c.discard_rate * 100).toFixed(1)}%`}></span></span><span class="pn-bar-value">{pct(c.discard_rate)}</span></li>
            ))}
          </ol>
        </div>
      </div>

      <h3 class="pn-sub">Alertas de validade crítica <span class="pn-tag pn-tag--sim">Simulado</span></h3>
      <p class="pn-note">Numa manhã simulada com {painel.alerts.sample} lotes, {painel.alerts.count} vencem em até {painel.alerts.window_hours} horas e {painel.alerts.high} têm risco alto pelo modelo. Os que mais precisam sair primeiro:</p>
      <div class="pn-table-wrap">
        <table class="pn-alerts">
          <thead><tr><th scope="col">Lote</th><th scope="col">Comida</th><th scope="col">Região</th><th scope="col">kg</th><th scope="col">Vence em</th><th scope="col">Risco de descarte</th></tr></thead>
          <tbody>
            {painel.alerts.top.map(a => (
              <tr><td class="mono">{a.lot}</td><td>{a.category} · {a.storage.toLowerCase()}</td><td>{a.region}</td><td>{a.kg.toLocaleString('pt-BR')}</td><td>{a.hours_to_expiry.toLocaleString('pt-BR')} h</td>
                <td><span class={`pn-risk pn-risk--${a.risk_level}`}>{risk[a.risk_level]}</span> {pct(a.discard_proba)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pn-note">O risco é uma estimativa do modelo, não laudo sanitário. Comida vencida nunca entra: o servidor recusa validade no passado.</p>
    </section>

    <section class="pn-block" aria-labelledby="pn-sec-title">
      <h2 id="pn-sec-title" class="kicker">Segurança e entrega contínua <span class="pn-tag pn-tag--real">Real</span></h2>
      <div class="pn-kpis">
        <div class="pn-kpi"><strong>{fmt.format(security.mitigated.total)}</strong><span>vulnerabilidades corrigidas desde a linha de base</span></div>
        <div class="pn-kpi"><strong>{fmt.format(security.baseline.total)} → {fmt.format(security.current.total)}</strong><span>achados dos scans ({security.baseline.commit} → {security.current.commit})</span></div>
        <div class="pn-kpi"><strong>0</strong><span>achados novos</span></div>
        <div class="pn-kpi"><strong>2</strong><span>gates que barram o deploy</span></div>
      </div>
      <div class="pn-two">
        <div>
          <h3 class="pn-sub">Por ferramenta</h3>
          <ul class="pn-tools">
            {tools.map(([name, v]) => <li><span>{name}</span><span class="mono">{v.baseline} → {v.current}{v.mitigated_ids.length ? ` (${v.mitigated_ids.length} corrigidas)` : ''}</span></li>)}
          </ul>
        </div>
        <div>
          <h3 class="pn-sub">Gates do pipeline</h3>
          <ul class="pn-gates">
            <li><Icon name="shield" /><p><strong>Bandit:</strong> {security.gates.bandit}.</p></li>
            <li><Icon name="shield" /><p><strong>Trivy:</strong> {security.gates.trivy}.</p></li>
            <li><Icon name="check" /><p><strong>Testes e retreino:</strong> pytest e o retreino do modelo conferido com o metrics.json.</p></li>
            <li><Icon name="arrow-right" /><p><strong>Deploy:</strong> só sobe pro Render depois de tudo isso verde, na main.</p></li>
          </ul>
        </div>
      </div>
      <p class="pn-note">{commit ? <>Esta versão do site é do commit <span class="mono">{commit.slice(0, 7)}</span>. </> : null}<a href={workflow} rel="noopener">Ver a última execução do pipeline no GitHub</a>, com os relatórios de cada scan. Riscos aceitos e por quê estão no <a href={`${REPO_URL}/blob/main/alimenta/seguranca/resumo.json`} rel="noopener">resumo</a>; a análise de ameaças está no <a href={`${REPO_URL}/blob/main/docs/alimenta/STRIDE.md`} rel="noopener">STRIDE</a>.</p>
    </section>

    <section class="pn-block" aria-labelledby="pn-api-title">
      <h2 id="pn-api-title" class="kicker">Por dentro</h2>
      <ul class="pn-links">
        <li><a href="https://rede-alimenta-api-u5q4.onrender.com/docs" rel="noopener">API com Swagger</a> FastAPI no Render, banco Postgres no Supabase.</li>
        <li><a href={`${REPO_URL}/tree/main/alimenta`} rel="noopener">Código do servidor e do modelo</a> Python, scikit-learn, Docker e Compose.</li>
        <li><a href={`${REPO_URL}/blob/main/docs/alimenta/README.md`} rel="noopener">Como funciona e como rodar</a> no seu computador com <span class="mono">docker compose up</span>.</li>
      </ul>
    </section>
  </Caderno>
</BaseLayout>

<script>import '../../scripts/alimenta-painel';</script>

<style>
  .pn-legend{ display:grid; gap:.5rem; margin-top:0; font:400 var(--t-small)/1.45 var(--font-sans); color:var(--ink-2) }
  .pn-tag{ display:inline-block; padding:.1rem .45rem; margin-right:.3rem; border:2px solid currentColor; font:700 var(--t-label)/1.2 var(--font-sans); letter-spacing:.06em; text-transform:uppercase; vertical-align:.1em }
  .pn-tag--real{ color:var(--success) }
  .pn-tag--model{ color:var(--info) }
  .pn-tag--sim{ color:var(--example-ink); background:repeating-linear-gradient(135deg, var(--example-a) 0 6px, var(--example-b) 6px 12px) }
  .kicker .pn-tag{ margin-left:.5rem }
  .pn-block{ margin-top:var(--space-12); padding-top:var(--space-4); border-top:2px solid var(--ink) }
  .pn-lead{ max-width:46rem; margin-top:var(--space-4); font:400 var(--t-ui)/1.5 var(--font-sans) }
  .pn-kpis{ display:grid; grid-template-columns:repeat(2, 1fr); gap:var(--space-4); margin-top:var(--space-6) }
  @media (min-width:900px){ .pn-kpis{ grid-template-columns:repeat(4, 1fr) } }
  .pn-kpi{ display:grid; gap:.3rem; padding:var(--space-3) var(--space-4); border:2px solid var(--ink); background:var(--paper) }
  .pn-kpi strong{ font:500 clamp(1.7rem, 1.4rem + 1.2vw, 2.4rem)/1.05 var(--font-display) }
  .pn-kpi span{ font:400 var(--t-small)/1.35 var(--font-sans); color:var(--ink-2) }
  .pn-note{ max-width:46rem; margin-top:var(--space-3); font:400 var(--t-small)/1.5 var(--font-sans); color:var(--ink-2) }
  .pn-note a, .pn-links a{ font-weight:700; color:var(--ink) }
  .pn-sub{ margin-top:var(--space-6); font:600 var(--t-card)/1.25 var(--font-serif) }
  .pn-two{ display:grid; gap:var(--space-6) var(--space-12) }
  @media (min-width:900px){ .pn-two{ grid-template-columns:1fr 1fr } }
  .pn-bars{ display:grid; gap:.55rem; margin-top:var(--space-3) }
  .pn-bars li{ display:grid; grid-template-columns:minmax(8.5rem, 13rem) 1fr 4.4rem; gap:.6rem; align-items:center; font:400 var(--t-small)/1.3 var(--font-sans) }
  .pn-bars li.is-main{ font-weight:700 }
  .pn-bar{ height:.9rem; background:var(--paper-2); border:1px solid var(--control-border) }
  .pn-bar > span{ display:block; height:100%; background:var(--info) }
  .pn-bars li.is-main .pn-bar > span{ background:var(--ink) }
  .pn-bar--warn > span{ background:var(--warning) }
  .pn-bar-value{ text-align:right; font-family:var(--font-mono) }
  .pn-matrix, .pn-alerts{ width:100%; margin-top:var(--space-3); border-collapse:collapse; font:400 var(--t-small)/1.35 var(--font-sans) }
  .pn-matrix th, .pn-matrix td, .pn-alerts th, .pn-alerts td{ padding:.55rem .6rem; border:1px solid var(--rule); text-align:left }
  .pn-matrix td{ font:500 1.5rem/1 var(--font-display); text-align:center }
  .pn-matrix td.ok{ background:var(--success-bg) }
  .pn-matrix thead th, .pn-alerts thead th{ font-weight:700 }
  .pn-table-wrap{ overflow-x:auto }
  .pn-alerts{ min-width:36rem }
  .pn-risk{ display:inline-block; padding:.05rem .4rem; font-weight:700; border:2px solid currentColor }
  .pn-risk--high{ color:var(--error) }
  .pn-risk--medium{ color:var(--warning) }
  .pn-risk--low{ color:var(--success) }
  .pn-map{ margin:var(--space-3) 0 0 }
  .pn-map svg{ width:100%; height:auto; display:block }
  .pn-map-name{ font:700 17px/1 var(--font-sans) }
  .pn-map-val{ font:700 18px/1 var(--font-sans) }
  .pn-map-scale{ font:400 13px/1 var(--font-sans); fill:var(--ink-2) }
  .pn-map figcaption{ margin-top:.5rem; font:400 var(--t-small)/1.45 var(--font-sans); color:var(--ink-2) }
  .pn-tools, .pn-gates, .pn-links{ display:grid; gap:.6rem; margin-top:var(--space-3); font:400 var(--t-small)/1.45 var(--font-sans) }
  .pn-tools li{ display:flex; justify-content:space-between; gap:1rem; padding-bottom:.45rem; border-bottom:1px solid var(--rule) }
  .pn-gates li{ display:grid; grid-template-columns:1.4rem 1fr; gap:.6rem }
  .pn-gates .icon{ width:1.2rem; height:1.2rem; margin-top:.15rem; color:var(--accent) }
  .pn-links a{ display:inline-flex; align-items:center; min-height:44px; margin-right:.4rem }
</style>
