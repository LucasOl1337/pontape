---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Caderno from '../../components/cronica/Caderno.astro';
import Icon from '../../components/site/Icon.astro';
import StateNote from '../../components/site/StateNote.astro';
import { PROJECT_NAME, formatDay } from '../../data/site/project';
import { serviceTrail } from '../../data/site/nav';
import { mapUrl, scheduling } from '../../data/alimenta/combina';
import { ALIMENTA, CATEGORY, DISTRIBUTORS, FROM, KIND, REGION, cities, lastAccess, suggestUrl } from '../../data/alimenta/rede';

// The public catalog (Q6): organizations that already hand out food, each with its source and the
// day it was read. Static page; the filter is a few lines of JS and without JS the whole list shows.
// F44 (plano 3.1): a short top, the city always in reach, the food filters folded, and a short card
// whose "como doar" opens in place. On a phone the first card used to sit at 876px.
const categories = Object.entries(CATEGORY).filter(([id]) => DISTRIBUTORS.some(d => d.accepts.includes(id as never)));
const newest = DISTRIBUTORS.map(lastAccess).sort().at(-1)!;
const order = Object.keys(CATEGORY) as (keyof typeof CATEGORY)[];
const site = Astro.site;
---
<BaseLayout title={`Onde doar comida · ${ALIMENTA.name} · ${PROJECT_NAME}`}
  description={`${DISTRIBUTORS.length} organizações que já distribuem comida em São Paulo e região, cada uma com a fonte pública e a data em que foi lida.`}
  current="alimenta">
  <Caderno trail={serviceTrail('Onde doar', site)} title="Onde doar" turn="comida."
    lead={`${DISTRIBUTORS.length} lugares que recebem e repassam pra quem precisa. Sem conta. Cada um tem a fonte de onde veio.`}>
    <form class="al-filters" id="al-filters" role="search" aria-label="Filtrar distribuidores">
      <label class="al-field"><span>Sua cidade</span>
        <select id="al-city"><option value="">Todas as cidades</option>{cities().map(c => <option value={c}>{c}</option>)}</select>
      </label>
      <p class="al-count" id="al-count" aria-live="polite">{DISTRIBUTORS.length} distribuidores</p>
      <details class="al-more-filters" id="al-more-filters">
        <summary><Icon name="chevron-down" /><span>Filtrar pelo tipo de comida</span><span class="al-active" id="al-active"></span></summary>
        <div class="filters" role="group" aria-label="O que aceita">
          <button class="filter" type="button" data-cat="" aria-pressed="true">Tudo</button>
          {categories.map(([id, label]) => <button class="filter" type="button" data-cat={id} aria-pressed="false">{label}</button>)}
        </div>
      </details>
    </form>

    <ol class="al-list" id="al-list">
      {DISTRIBUTORS.map(d => {
        const book = scheduling(d.how_to_donate);
        return (
        <li class="al-item" id={d.id} data-city={d.city} data-cats={d.accepts.join(' ')}>
          <article aria-labelledby={`n-${d.id}`}>
            <p class="al-meta">{KIND[d.kind]} · {d.city}{d.city === 'São Paulo' && d.region !== 'metro' ? `, ${REGION[d.region]}` : ''}</p>
            <h2 class="al-name" id={`n-${d.id}`}>{d.name}</h2>
            <p class="al-summary">
              {d.accepts.length > 0 ? `Aceita ${order.filter(c => d.accepts.includes(c)).map(c => CATEGORY[c].toLowerCase()).join(', ')}.` : 'A fonte não diz que tipo de comida aceita.'}
              {' '}Recebe de {d.receives_from.map(r => FROM[r].toLowerCase()).join(' e ')}.
            </p>
            {d.hours_public && <p class="al-hours"><Icon name="clock" /><span>{d.hours_public}</span></p>}
            <details class="al-how">
              <summary><Icon name="chevron-down" />Como doar aqui</summary>
              <dl class="al-facts">
                <div><dt>Como doar</dt><dd>{d.how_to_donate ?? 'A fonte não diz. Fale com o contato oficial antes de levar.'}</dd></div>
                <div><dt>Precisa agendar?</dt><dd>{book === 'yes' ? 'Sim. Combine antes de levar.' : 'A fonte não diz. Na dúvida, fale antes.'}</dd></div>
                {d.address_public && <div><dt>Endereço</dt><dd>{d.address_public} · <a href={mapUrl({ name: d.name, city: d.city, address: d.address_public })} rel="noopener" target="_blank">Ver no mapa</a></dd></div>}
              </dl>
              <p class="al-source">Fonte{d.sources.length > 1 ? 's' : ''}, lida em <time datetime={lastAccess(d)}>{formatDay(lastAccess(d))}</time>{d.confidence === 'medium' && '. Confirme antes de levar'}:
                {d.sources.map(s => <> <q>{s.quote}</q> <a href={s.url} rel="noopener" target="_blank">{new URL(s.url).hostname.replace(/^www\./, '')}</a></>)}
              </p>
              {d.capacity_note && <p class="al-source">{d.capacity_note}</p>}
            </details>
            <p class="al-links"><a class="more-link" href={d.public_contact_url} rel="noopener" target="_blank">Contato oficial<Icon name="arrow-right" /></a><a class="al-fix" href={suggestUrl(d)} rel="noopener">Corrigir</a></p>
          </article>
        </li>
      ); })}
    </ol>
    <StateNote kind="empty" id="al-empty" title="Ninguém nesta cidade aceita esse tipo de comida ainda" hidden headingLevel={2}>
      <p>Troque o tipo de comida ou veja todas as cidades. Conhece um lugar que recebe? <a href={suggestUrl()} rel="noopener">Sugira um</a> com a fonte pública.</p>
      <Fragment slot="actions"><button class="btn" type="button" id="al-clear">Ver todos</button></Fragment>
    </StateNote>

    <p class="al-note"><Icon name="search" /><span>Lista lida em sites oficiais em <time datetime={newest}>{formatDay(newest)}</time>. Ninguém aqui pagou pra aparecer. Achou algo errado ou falta alguém? <a href={suggestUrl()} rel="noopener">Sugerir ou corrigir</a>.</span></p>

    <section class="al-next" aria-labelledby="al-next-title">
      <h2 id="al-next-title" class="kicker">Não sabe qual escolher?</h2>
      <p class="prose-p">Diga o que você tem e a cidade. O site mostra quem combina, sem conta.</p>
      <p class="actions"><a class="btn btn--ink" href={ALIMENTA.doar}>Ver quem combina com a minha doação<Icon name="arrow-right" /></a></p>
    </section>
  </Caderno>
</BaseLayout>
<script>import '../../scripts/alimenta-distribuidores';</script>

<style>
  :global(.caderno:has(#al-list) .caderno-head){ padding-bottom:var(--space-4) }
  :global(.caderno:has(#al-list) .caderno-lead){ font-size:var(--t-ui) }
  .al-filters{ position:sticky; top:var(--header-h); z-index:5; display:grid; grid-template-columns:minmax(0, 22rem) 1fr; align-items:end; gap:.4rem var(--space-4); margin:0 calc(-1 * var(--gutter)); padding:var(--space-3) var(--gutter); background:var(--paper); border-bottom:2px solid var(--ink) }
  .al-field{ display:grid; gap:.3rem; font:700 var(--t-small)/1.3 var(--font-sans) }
  .al-field select{ min-height:48px; padding:.6rem .7rem; border:2px solid var(--control-border); border-radius:0; background:var(--paper); color:var(--ink); font:400 var(--t-ui)/1.4 var(--font-sans) }
  @media (max-width:559px){ .al-filters{ grid-template-columns:1fr } .al-count{ grid-row:1; justify-self:end; margin-bottom:-1.6rem } }
  .al-count{ align-self:center; font:700 var(--t-label)/1.3 var(--font-sans); letter-spacing:.14em; text-transform:uppercase; color:var(--ink-2) }
  .al-more-filters{ grid-column:1 / -1 }
  .al-more-filters summary, .al-how summary{ display:inline-flex; align-items:center; gap:.4rem; min-height:44px; cursor:pointer; font:700 var(--t-small)/1.3 var(--font-sans); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.18em; list-style:none }
  .al-more-filters summary::-webkit-details-marker, .al-how summary::-webkit-details-marker{ display:none }
  .al-more-filters[open] > summary .icon, .al-how[open] > summary .icon{ transform:rotate(180deg) }
  .al-active{ font-weight:400; color:var(--ink-2); text-decoration:none }
  .al-more-filters .filters{ margin:.2rem 0 .3rem }
  .al-list{ display:grid }
  @media (min-width:900px){ .al-list{ grid-template-columns:1fr 1fr; column-gap:var(--space-12) } }
  .al-item{ display:flex; padding:var(--space-4) 0; border-bottom:1px solid var(--rule) }
  .al-item > article{ display:flex; flex-direction:column; width:100% }
  .al-meta{ font:700 var(--t-label)/1.3 var(--font-sans); letter-spacing:.12em; text-transform:uppercase; color:var(--accent) }
  .al-name{ margin-top:.3rem; font:600 var(--t-card)/1.2 var(--font-serif); text-wrap:balance }
  .al-summary{ margin-top:.4rem; font:400 var(--t-ui)/1.45 var(--font-sans) }
  .al-hours{ display:flex; gap:.4rem; align-items:flex-start; margin-top:.35rem; font:400 var(--t-small)/1.45 var(--font-sans); color:var(--ink-2) }
  .al-hours .icon{ flex:none; width:1rem; height:1rem; margin-top:.15rem }
  .al-how{ margin-top:.2rem }
  .al-facts{ display:grid; gap:.5rem; margin-top:.2rem; font:400 var(--t-small)/1.5 var(--font-sans) }
  .al-facts dt{ font-weight:700 }
  .al-facts dd{ margin:0; color:var(--ink-2) }
  .al-facts a, .al-source a{ font-weight:700; overflow-wrap:anywhere }
  .al-source{ margin-top:.6rem; font:400 var(--t-small)/1.5 var(--font-sans); color:var(--ink-2) }
  .al-source q{ font-style:italic }
  .al-links{ display:flex; flex-wrap:wrap; gap:0 1.25rem; align-items:center; margin-top:auto; padding-top:.2rem }
  .al-links a{ min-height:44px; display:inline-flex; align-items:center }
  .al-fix{ font:400 var(--t-small)/1.3 var(--font-sans); color:var(--ink-2) }
  .al-note{ display:flex; gap:.6rem; align-items:flex-start; max-width:46rem; margin-top:var(--space-8); padding:.85rem 1rem; border-left:3px solid var(--accent); background:var(--paper-2); font:400 var(--t-small)/1.5 var(--font-sans) }
  .al-note .icon{ margin-top:.15rem; color:var(--accent) }
  .al-note a{ font-weight:700 }
  .al-next{ margin-top:var(--space-12); padding-top:var(--space-6); border-top:2px solid var(--ink) }
  .al-next .prose-p{ max-width:40rem; margin-top:.5rem }
  .al-next .actions{ margin-top:var(--space-4) }
</style>
