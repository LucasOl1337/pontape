---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Caderno from '../../components/cronica/Caderno.astro';
import Icon from '../../components/site/Icon.astro';
import StateNote from '../../components/site/StateNote.astro';
import AlimentaLogin from '../../components/alimenta/AlimentaLogin.astro';
import { PROJECT_NAME } from '../../data/site/project';
import { serviceTrail } from '../../data/site/nav';
import { ALIMENTA, DONATION_CATEGORIES, DONOR_KINDS, STORAGE, browserCatalog, cities, suggestUrl } from '../../data/alimenta/rede';
import '../../styles/alimenta.css';
import '../../styles/estado.css';

// The donor flow, turned around (F44, plano 3.2): first what you have, with no account, and the page
// shows who takes it, by the same rule the API uses; then the "ready to take it" screen (3.4); only at
// the end, and only if you want it in the public book, the e-mail. Before asking it the page reads
// /health: with sign-up closed the e-mail field never shows (1.2). ?exemplo=1 walks the same screens
// with an invented donation and never writes (3.5). Without JS the page points at the list.
const UFS = 'AC AL AM AP BA CE DF ES GO MA MG MS MT PA PB PE PI PR RJ RN RO RR RS SC SE SP TO'.split(' ');
const site = Astro.site;
const STEPS = 4;
---
<BaseLayout title={`Doar comida · ${ALIMENTA.name} · ${PROJECT_NAME}`}
  description="Diga o que você tem e veja quem recebe perto de você, sem conta. Se quiser, registre no livro público."
  current="alimenta">
  <Caderno trail={serviceTrail('Doar', site)} title="Doar" turn="comida."
    lead="Diga o que você tem e a gente mostra quem recebe, sem conta. Leva uns 2 minutos. Se quiser, no fim você registra no livro público.">
    <noscript><p class="al-msg" data-kind="error">Esta página precisa de JavaScript ligado. A <a href={ALIMENTA.distribuidores}>lista de onde doar</a> funciona sem ele.</p></noscript>

    <section class="al-card al-step-card" id="al-offer" aria-labelledby="al-offer-title" tabindex="-1" hidden>
      <p class="al-step">Passo 1 de {STEPS}<span class="al-example-tag" hidden>Exemplo</span></p>
      <h2 class="al-card-title" id="al-offer-title">O que você tem pra doar?</h2>
      <p class="al-hint">Sem conta e sem e-mail. Nada aqui é enviado: a busca acontece no seu aparelho.</p>
      <form id="al-offer-form" class="al-form" novalidate>
        <fieldset><legend>Tipo de comida</legend>
          <div class="al-choices al-choices--two">{DONATION_CATEGORIES.map((c, i) => <label class="al-choice"><input type="radio" name="category" value={c.id} checked={i === 0} /><span><b>{c.label}</b><small>{c.hint}</small></span></label>)}</div>
        </fieldset>
        <fieldset><legend>Você doa como</legend>
          <div class="al-choices al-choices--three">{DONOR_KINDS.map((k, i) => <label class="al-choice"><input type="radio" name="kind" value={k.id} checked={i === 0} /><span><b>{k.label}</b><small>{k.hint}</small></span></label>)}</div>
        </fieldset>
        <fieldset><legend>Onde está guardada</legend>
          <div class="al-choices al-choices--three">{STORAGE.map((s, i) => <label class="al-choice"><input type="radio" name="storage" value={s.id} checked={i === 0} /><span><b>{s.label}</b></span></label>)}</div>
        </fieldset>
        <div class="al-grid2">
          <label class="al-field"><span>Quantos quilos, mais ou menos</span><input type="text" name="kg" id="al-kg" inputmode="decimal" maxlength="7" placeholder="Ex.: 12,5" aria-describedby="al-kg-error" required /><small class="al-field-error" id="al-kg-error" hidden></small></label>
          <label class="al-field"><span>Vale até</span><input type="date" name="expires" id="al-expires" aria-describedby="al-expires-error" required /><small class="al-field-error" id="al-expires-error" hidden></small></label>
        </div>
        <div class="al-grid2">
          <label class="al-field"><span>Cidade onde a comida está</span><input type="text" name="city" id="al-city-in" list="al-cities" maxlength="80" autocomplete="address-level2" aria-describedby="al-city-error" required /><small class="al-field-error" id="al-city-error" hidden></small></label>
          <label class="al-field"><span>Estado</span><select name="uf">{UFS.map(uf => <option value={uf} selected={uf === 'SP'}>{uf}</option>)}</select></label>
        </div>
        <datalist id="al-cities">{cities().map(c => <option value={c} />)}</datalist>
        <button class="btn btn--ink" type="submit">Ver quem recebe<Icon name="arrow-right" /></button>
      </form>
      <p class="al-signup-note" id="al-signup-note" hidden></p>
    </section>

    <section class="al-card al-step-card" id="al-match" aria-labelledby="al-match-title" tabindex="-1" hidden>
      <p class="al-step">Passo 2 de {STEPS}<span class="al-example-tag" hidden>Exemplo</span></p>
      <h2 class="al-card-title" id="al-match-title">Quem recebe o que você tem</h2>
      <p class="al-hint" id="al-match-intro"></p>
      <div id="al-match-body"></div>
      <p class="al-row al-back"><button class="btn al-quiet" type="button" data-goto="al-offer"><Icon name="arrow-left" />Mudar a doação</button></p>
    </section>

    <section class="al-card al-step-card al-done" id="al-ready" aria-labelledby="al-ready-title" tabindex="-1" hidden>
      <p class="al-step">Passo 3 de {STEPS}<span class="al-example-tag" hidden>Exemplo</span></p>
      <h2 class="al-card-title" id="al-ready-title">Pronto. Agora é levar.</h2>
      <div id="al-ready-body"></div>
      <div class="al-ledger-offer">
        <h3>Quer que a doação conte no livro público?</h3>
        <p class="al-hint">É opcional. Com e-mail, a AI confere a sugestão e cada passo entra no livro, sem o seu nome.</p>
        <p class="al-row"><button class="btn" type="button" id="al-to-ledger">Registrar no livro (em teste)<Icon name="arrow-right" /></button><button class="btn al-quiet" type="button" data-goto="al-match"><Icon name="arrow-left" />Escolher outro</button></p>
      </div>
    </section>

    <section class="al-card al-step-card" id="al-ledger" aria-labelledby="al-ledger-title" tabindex="-1" hidden>
      <p class="al-step">Passo 4 de {STEPS}<span class="al-example-tag" hidden>Exemplo</span></p>
      <h2 class="al-card-title" id="al-ledger-title">Registrar no livro</h2>
      <p class="al-hint" id="al-ledger-summary"></p>
      <StateNote kind="unavailable" id="al-closed" title="O registro no livro ainda está fechado" hidden headingLevel={3}>
        <p id="al-closed-text">Estamos ligando o envio de e-mail e revisando os textos. Sua doação não depende disso: o distribuidor que você escolheu já recebe direto.</p>
        <Fragment slot="actions"><a class="btn btn--ink" href={ALIMENTA.distribuidores}>Ver onde doar</a><button class="btn al-quiet" type="button" id="al-have-account">Já tenho conta de doador</button></Fragment>
      </StateNote>
      <StateNote kind="example" id="al-example-end" title="No exemplo, o registro não acontece" hidden headingLevel={3}>
        <p>Numa doação de verdade, aqui você entra com o e-mail, a AI confere a sugestão e a doação entra no livro público com um código, sem o seu nome. Nada deste exemplo foi enviado, nem entra no livro ou nos números.</p>
        <Fragment slot="actions"><a class="btn btn--ink" href={ALIMENTA.doar}>Sair do exemplo e doar de verdade</a></Fragment>
      </StateNote>
      <StateNote kind="loading" id="al-health-wait" title="Conferindo se o registro está aberto" hidden headingLevel={3}>
        <p>Leva alguns segundos. A primeira vez pode levar até 1 minuto.</p>
      </StateNote>
      <AlimentaLogin />
      <div id="al-account" hidden>
        <form id="al-signup-form" class="al-form" novalidate hidden>
          <h3 class="al-sub" id="al-signup-title">Sua conta de doador</h3>
          <p class="al-hint">Só isto. Sem CPF, sem endereço, sem telefone. A cidade já vem da sua doação.</p>
          <fieldset><legend>Você doa como</legend>
            <div class="al-choices al-choices--three">{DONOR_KINDS.map((k, i) => <label class="al-choice"><input type="radio" name="kind" value={k.id} checked={i === 0} /><span><b>{k.label}</b><small>{k.hint}</small></span></label>)}</div>
          </fieldset>
          <div class="al-grid2">
            <label class="al-field"><span>Cidade</span><input type="text" name="city" maxlength="80" autocomplete="address-level2" required /></label>
            <label class="al-field"><span>Estado</span><select name="uf">{UFS.map(uf => <option value={uf} selected={uf === 'SP'}>{uf}</option>)}</select></label>
          </div>
          <label class="al-field" id="al-cnpj-field" hidden><span>CNPJ <small>(se quiser)</small></span><input type="text" name="cnpj" inputmode="numeric" maxlength="18" /></label>
          <details class="al-legal"><summary>Ler o termo de doação</summary><pre id="al-terms-text">Carregando…</pre></details>
          <details class="al-legal"><summary>Ler o aviso de privacidade</summary><pre id="al-privacy-text">Carregando…</pre></details>
          <label class="al-check"><input type="checkbox" name="accept" required /><span>Li e aceito o termo de doação e o aviso de privacidade <span id="al-versions"></span>.</span></label>
          <button class="btn btn--ink" type="submit">Criar minha conta</button>
        </form>
        <form id="al-register-form" class="al-form" novalidate hidden>
          <label class="al-check"><input type="checkbox" name="declare" required /><span>A comida está na validade, bem guardada e é de graça pra quem recebe, como diz o termo de doação.</span></label>
          <button class="btn btn--ink" type="submit">Registrar e ver a sugestão da AI<Icon name="arrow-right" /></button>
        </form>
      </div>
      <div id="al-reco" aria-live="polite" data-suggest={suggestUrl()} hidden>
        <h3 class="al-sub">O que a AI sugere</h3>
        <p class="al-hint" id="al-reco-intro"></p>
        <div id="al-reco-body"></div>
      </div>
      <div id="al-done" tabindex="-1" hidden>
        <StateNote kind="success" title="Registrada no livro" headingLevel={3}>
          <div id="al-done-body"></div>
          <p>A doação entra no livro público em alguns minutos. Quando entregar, marque em <a href={ALIMENTA.minhas}>Minhas doações</a>.</p>
          <Fragment slot="actions"><a class="btn btn--ink" href={ALIMENTA.minhas}>Minhas doações</a><button class="btn al-quiet" type="button" id="al-again">Doar outra coisa</button></Fragment>
        </StateNote>
      </div>
    </section>

    <p class="al-hint al-foot">Não achou distribuidor na sua cidade? <a href={suggestUrl()} rel="noopener">Sugira um</a> com a fonte pública. <a href={ALIMENTA.minhas}>Minhas doações</a> · <a href={`${ALIMENTA.doar}?exemplo=1`}>Ver um exemplo</a></p>
  </Caderno>
  <script type="application/json" id="al-catalog" set:html={JSON.stringify(browserCatalog()).replaceAll('<', '\\u003c')} />
</BaseLayout>
<script>import '../../scripts/alimenta-doar';</script>
<style>
  .al-foot{ margin-top:var(--space-8) }
  .al-foot a{ display:inline-flex; align-items:center; min-height:44px; font-weight:700 }
</style>
