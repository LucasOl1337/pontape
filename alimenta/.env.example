# Rede Alimenta · variáveis de ambiente (corte r6: só doador).
# Copie para alimenta/.env (ignorado pelo git) só se quiser; os comandos leem do ambiente.
# Nunca coloque senha, chave ou token reais neste arquivo de exemplo.

# production (padrão): sem login local. local: testes, compose e ensaio.
ALIMENTA_ENV=local
# Banco. Padrão local: SQLite. Compose: postgresql+psycopg://alimenta:alimenta@db:5432/alimenta
# Produção: pooler do Supabase rede-alimenta-sp (sa-east-1) em modo sessão, porta 5432.
# O código aceita postgresql:// ou postgres:// e troca para postgresql+psycopg://.
# Esquema só por migração: alimenta/.venv/bin/python -m alimenta.db.migrate (a API também migra ao subir).
DATABASE_URL=sqlite:///./alimenta.db
# Projeto Supabase do login (código de 6 dígitos no e-mail) e do JWKS que valida o JWT.
SUPABASE_URL=
# Chave publicável sb_publishable_* (só pede e confere o código).
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta sb_secret_*: só para apagar o login no Supabase em DELETE /me.
# Vazia: o pedido fica pendente em account_deletions e a varredura tenta de novo.
SUPABASE_SECRET_KEY=
# E-mails com papel operator, separados por vírgula. Operador nunca vem de cadastro.
ALIMENTA_OPERATOR_EMAILS=
# Contas de teste (e-mail ou @dominio): fora de KPI e de livro; o ensaio apaga.
ALIMENTA_TEST_EMAILS=@teste.alimenta
# Cadastro de doador de fora do time. true quando o SMTP próprio estiver no ar.
ALIMENTA_SIGNUP_OPEN=false
# Token só da automação: vale apenas em POST /ops/sweep (cabeçalho X-Alimenta-Ops-Token).
ALIMENTA_OPS_TOKEN=
# Cada passo de doação real vai para o livro de pontape.org (família donation). false até o Lucas autorizar.
ALIMENTA_PUBLISH_REAL_LEDGER=false
# GitHub fine-grained, Actions: write, só este repositório. Vazio = não publica mesmo com a flag.
ALIMENTA_LEDGER_DISPATCH_TOKEN=
ALIMENTA_GITHUB_REPO=LucasOl1337/pontape
# Recomendação de destino com AI pelo 9Router (OpenAI-compatível; /v1 é acrescentado se faltar).
# Vazio: a recomendação usa só a regra do catálogo e diz isso na resposta.
ALIMENTA_AI_BASE_URL=
ALIMENTA_AI_KEY=
ALIMENTA_AI_MODEL=cc/claude-haiku-4-5-20251001
ALIMENTA_AI_FALLBACK_MODEL=cx/gpt-5.6-luna
# Busca web aberta (9Router /v1/search). Desligada: a AI só lê as páginas-fonte do catálogo.
ALIMENTA_AI_WEB_SEARCH=false
ALIMENTA_AI_SEARCH_MODEL=tavily
# Opcional: outro caminho do catálogo (padrão src/data/alimenta/distribuidores.json).
ALIMENTA_CATALOG_PATH=
# Opcional: outro caminho do artefato do modelo (o sha256 de metrics.json é conferido).
ALIMENTA_MODEL_PATH=
# Porta HTTP (o Render define sozinho).
PORT=8000

# --- E-mail do login ---
# O SMTP padrão do Supabase só entrega para membros do time do projeto e tem limite baixo.
# Para abrir a doadores de fora: SMTP próprio (Resend ou Brevo, remetente @pontape.org) em
# Supabase > Authentication > SMTP Settings, e o modelo "Magic Link" com {{ .Token }} no corpo.
