# Rede Alimenta · variáveis de ambiente (DEMONSTRAÇÃO · dados simulados).
# Copie para alimenta/.env (ignorado pelo git) só se quiser; os comandos leem do ambiente.
# Nunca coloque a senha real do banco neste arquivo de exemplo.

# --- API ---
# Banco. Padrão local: SQLite. Compose: postgresql+psycopg://alimenta:alimenta@db:5432/alimenta
# Produção: string do pooler Supabase em modo sessão (porta 5432). O código aceita
# postgresql:// ou postgres:// e troca para postgresql+psycopg://.
DATABASE_URL=sqlite:///./alimenta.db
# Token exigido no cabeçalho X-Alimenta-Token em toda escrita. Vazio = escrita desligada (503).
ALIMENTA_WRITE_TOKEN=
# Carrega o seed simulado na subida se o banco estiver vazio (idempotente).
ALIMENTA_SEED_ON_START=true
# Opcional: outro caminho do artefato do modelo (o sha256 de metrics.json é conferido).
ALIMENTA_MODEL_PATH=
# Opcional: caminho do tools/conferir.py (padrão: o do repositório).
ALIMENTA_CONFERIR_PATH=
# Porta HTTP (o Render define sozinho).
PORT=8000

# --- Painel ---
# Onde o servidor do painel encontra a API.
ALIMENTA_API_URL=http://localhost:8000
# Endereço da API que a pessoa abre no navegador (rodapé e link do Swagger).
ALIMENTA_PUBLIC_API_URL=http://localhost:8000
# Repositório cujo CI aparece na aba Segurança e CI.
ALIMENTA_GITHUB_REPO=LucasOl1337/pontape
# O painel usa o mesmo ALIMENTA_WRITE_TOKEN da API (fica só no servidor do painel).
