# CSP limita origens: scripts, estilos e fontes só do próprio site (fontes locais desde a F07).
# Única exceção (#55): o contador de visitas da Cloudflare (Web Analytics), que a hospedagem injeta.
# Libera só o arquivo dele em script-src e o envio da contagem em connect-src. Sem cookie, sem dado pessoal.
# O build acrescenta hashes dos scripts embutidos; os dados do livro vão em <script type="application/json">.
# Nosniff exige o tipo de conteúdo declarado.
# Referrer não envia origem ou caminho ao sair do site.
# Permissions nega recursos do aparelho ainda não usados, inclusive microfone.
# X-Frame-Options cobre navegadores sem suporte a frame-ancestors.
# HSTS: depois da primeira visita, o navegador só usa HTTPS em pontape.org e www.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(), camera=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Só os arquivos de /_astro/ têm nome com hash e podem ficar um ano no navegador.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes mudam raramente; uma semana de cache sem imutável, porque o nome não tem hash.
/fonts/*
  Cache-Control: public, max-age=604800
